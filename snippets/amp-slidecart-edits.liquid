<script>
  /* Exclude shipping protection from item count + rewards threshold.
     Row stays visually hidden via CSS; this stops the hidden line
     from inflating the header count and tripping reward tiers early. */
  var SC_SHIPPING_PROTECTION_MATCHERS = [
    'shipping-protection',
    'shipping protection',
    'slidecart - shipping protection'
  ];

  function scIsShippingProtection(item) {
    if (!item) return false;
    var fields = [item.handle, item.product_type, item.product_title, item.title];
    for (var i = 0; i < fields.length; i++) {
      var val = (fields[i] || '').toString().toLowerCase();
      if (!val) continue;
      for (var j = 0; j < SC_SHIPPING_PROTECTION_MATCHERS.length; j++) {
        if (val.indexOf(SC_SHIPPING_PROTECTION_MATCHERS[j]) !== -1) return true;
      }
    }
    return false;
  }

  function scRealItemCount(cart) {
    if (cart && Array.isArray(cart.items)) {
      return cart.items.reduce(function (sum, item) {
        if (scIsShippingProtection(item)) return sum;
        return sum + (item.quantity || 0);
      }, 0);
    }
    // DOM fallback — count line rows that aren't the protection row
    var items = document.querySelectorAll('#slidecarthq .item');
    var count = 0;
    items.forEach(function (el) {
      var text = (el.textContent || '').toLowerCase();
      if (text.indexOf('shipping protection') === -1) count += 1;
    });
    return count;
  }

  function scUpdateRewardsColor(cart) {
    const rewards = document.querySelector('.rewards[data-testid="TieredRewards"]');
    if (!rewards) return;
    var itemCount = scRealItemCount(cart);
    if (itemCount >= 2) {
      rewards.classList.add('rewards-unlocked');
    } else {
      rewards.classList.remove('rewards-unlocked');
    }
  }

  function scUpdateCartCount(cart) {
    var totalQty = scRealItemCount(cart);
    const countSelectors = [
      '#slidecarthq [class*="cart-count"]',
      '#slidecarthq [class*="count-label"]',
      '#slidecarthq [class*="header-count"]',
      '#slidecarthq header [class*="count"]'
    ];
    for (const sel of countSelectors) {
      const elements = document.querySelectorAll(sel);
      elements.forEach(el => {
        if (el.children.length === 0) {
          el.textContent = totalQty;
        }
      });
    }
  }

  window.SLIDECART_LOADED = (cart) => {
    scUpdateRewardsColor(cart);
    scUpdateCartCount(cart);
  };

  window.SLIDECART_UPDATED = (cart) => {
    scUpdateRewardsColor(cart);
    scUpdateCartCount(cart);
  };
</script>