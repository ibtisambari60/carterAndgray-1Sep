{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PRODUCT CARD COMPONENT — CARTER & GRAY
----------------------------------------------------------------------------------------------------------------------

Based on the original Prestige product card.

Preserved:
- Product links
- Product media
- Secondary image
- Quick add
- Quick-buy modal
- Badges
- Prices and compare-at prices
- Variant image switching
- Ratings
- Vendor
- Existing Shopify swatch data

Collection-page controls are read from section.settings.
{%- endcomment -%}

{%- liquid
  if hide_product_information
    assign show_badges = false
    assign show_rating = false
    assign show_vendor = false
    assign show_title = false
    assign show_prices = false
    assign show_swatches = false
    assign show_quick_buy = show_quick_buy | default: settings.show_quick_buy, allow_false: true
    assign show_secondary_image = show_secondary_image | default: settings.show_secondary_image, allow_false: true
  else
    assign show_badges = show_badges | default: true, allow_false: true
    assign show_rating = show_rating | default: settings.show_product_rating, allow_false: true
    assign show_vendor = show_vendor | default: settings.show_vendor, allow_false: true
    assign show_quick_buy = show_quick_buy | default: settings.show_quick_buy, allow_false: true
    assign show_title = true
    assign show_prices = true
    assign show_secondary_image = show_secondary_image | default: settings.show_secondary_image, allow_false: true
    assign show_swatches = show_swatches | default: true, allow_false: true
  endif

  assign matched_product_option = nil
  assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ','

  if show_swatches and settings.product_color_display != 'hide'
    for color_label in color_label_list
      if product.options_by_name[color_label] != blank
        assign matched_product_option = product.options_by_name[color_label]
        break
      endif
    endfor

    if matched_product_option == blank
      for product_option in product.options_with_values
        assign values_with_swatch = product_option.values | where: 'swatch'

        if values_with_swatch.size > 0
          assign matched_product_option = product_option
          break
        endif
      endfor
    endif
  endif

  assign cg_visible_swatches = section.settings.cg_visible_swatches | default: 3

  assign cg_info_top_mobile = section.settings.cg_info_top_mobile | default: 8
  assign cg_info_top_desktop = section.settings.cg_info_top_desktop | default: 10

  assign cg_swatch_size_mobile = section.settings.cg_swatch_size_mobile | default: 18
  assign cg_swatch_size_desktop = section.settings.cg_swatch_size_desktop | default: 20

  assign cg_swatch_gap_mobile = section.settings.cg_swatch_gap_mobile | default: 8
  assign cg_swatch_gap_desktop = section.settings.cg_swatch_gap_desktop | default: 9

  assign cg_swatch_title_gap_mobile = section.settings.cg_swatch_title_gap_mobile | default: 9
  assign cg_swatch_title_gap_desktop = section.settings.cg_swatch_title_gap_desktop | default: 10

  assign cg_title_price_gap_mobile = section.settings.cg_title_price_gap_mobile | default: 8
  assign cg_title_price_gap_desktop = section.settings.cg_title_price_gap_desktop | default: 10

  assign cg_title_size_mobile = section.settings.cg_title_size_mobile | default: 12
  assign cg_title_size_desktop = section.settings.cg_title_size_desktop | default: 14

  assign cg_price_size_mobile = section.settings.cg_price_size_mobile | default: 13
  assign cg_price_size_desktop = section.settings.cg_price_size_desktop | default: 14

  assign cg_more_size_mobile = section.settings.cg_more_size_mobile | default: 11
  assign cg_more_size_desktop = section.settings.cg_more_size_desktop | default: 12

  assign cg_selected_outline = section.settings.cg_selected_outline | default: 1
  assign cg_selected_offset = section.settings.cg_selected_offset | default: 2
-%}

<style>
  product-card.product-card {
    position: relative;
    overflow: visible;

    --cg-info-top-mobile: {{ cg_info_top_mobile }}px;
    --cg-info-top-desktop: {{ cg_info_top_desktop }}px;

    --cg-swatch-size-mobile: {{ cg_swatch_size_mobile }}px;
    --cg-swatch-size-desktop: {{ cg_swatch_size_desktop }}px;

    --cg-swatch-gap-mobile: {{ cg_swatch_gap_mobile }}px;
    --cg-swatch-gap-desktop: {{ cg_swatch_gap_desktop }}px;

    --cg-swatch-title-gap-mobile: {{ cg_swatch_title_gap_mobile }}px;
    --cg-swatch-title-gap-desktop: {{ cg_swatch_title_gap_desktop }}px;

    --cg-title-price-gap-mobile: {{ cg_title_price_gap_mobile }}px;
    --cg-title-price-gap-desktop: {{ cg_title_price_gap_desktop }}px;

    --cg-title-size-mobile: {{ cg_title_size_mobile }}px;
    --cg-title-size-desktop: {{ cg_title_size_desktop }}px;

    --cg-price-size-mobile: {{ cg_price_size_mobile }}px;
    --cg-price-size-desktop: {{ cg_price_size_desktop }}px;

    --cg-more-size-mobile: {{ cg_more_size_mobile }}px;
    --cg-more-size-desktop: {{ cg_more_size_desktop }}px;

    --cg-selected-outline: {{ cg_selected_outline }}px;
    --cg-selected-offset: {{ cg_selected_offset }}px;
  }

  product-card .product-card__figure {
    margin-bottom: -10;
  }

  product-card .product-media-banner {
    position: absolute;
    left: 0;
    z-index: 2;
    width: max-content;
    padding: 5px 10px;
    border-radius: 0;
    pointer-events: none;
    text-transform: uppercase;
  }

  /* ==================================================
     PRODUCT INFORMATION
  ================================================== */

  product-card .product-card__info {
    position: relative;
    width: 100%;
    margin: 0;
    padding: var(--cg-info-top-mobile) 0 0;
  }

  product-card .cg-card-information {
    display: flex;
    width: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    margin: 0;
    padding: 0;
    text-align: left;
  }

  product-card .cg-card-vendor {
    width: 100%;
    margin: 0 0 6px;
    text-align: left;
  }

  /* ==================================================
     SWATCHES
  ================================================== */

  product-card .cg-card-swatches {
    display: flex;
    width: 100%;
    min-width: 0;
    min-height: var(--cg-swatch-size-mobile);
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: var(--cg-swatch-gap-mobile);
    margin: 0 0 var(--cg-swatch-title-gap-mobile);
    padding: var(--cg-selected-offset);
    border: 0;
  }

  product-card .cg-card-swatches .color-swatch {
    --swatch-size: var(--cg-swatch-size-mobile);

    position: relative;
    display: block;
    flex: 0 0 var(--cg-swatch-size-mobile);

    width: var(--cg-swatch-size-mobile);
    height: var(--cg-swatch-size-mobile);
    min-width: var(--cg-swatch-size-mobile);
    min-height: var(--cg-swatch-size-mobile);
    max-width: var(--cg-swatch-size-mobile);
    max-height: var(--cg-swatch-size-mobile);

    margin: 0;
    padding: 0;

    border: 1px solid #a5a5a5;
    border-radius:
      {% if settings.round_color_swatches %}
        50%
      {% else %}
        0
      {% endif %};

    outline: none;
    box-shadow: none;

    background:
      var(--swatch-background)
      center
      /
      cover
      no-repeat;

    box-sizing: border-box;
    cursor: pointer;
  }

  product-card .cg-card-swatches input:checked + .color-swatch,
  product-card .cg-card-swatches .color-swatch.is-selected {
    border-color: #757575;
    outline: var(--cg-selected-outline) solid #171717;
    outline-offset: var(--cg-selected-offset);
  }

  product-card .cg-card-swatches .color-swatch.is-disabled {
    opacity: 0.4;
  }

  product-card .cg-card-swatch-more {
    display: inline-flex;
    flex: 0 0 auto;
    height: var(--cg-swatch-size-mobile);
    align-items: center;
    justify-content: flex-start;
    margin: 0 0 0 1px;
    padding: 0;

    color: #171717;
    font-size: var(--cg-more-size-mobile);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  product-card .cg-card-color-count {
    width: 100%;
    margin: 0 0 var(--cg-swatch-title-gap-mobile);
    color: #666666;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
    text-align: left;
  }

  /* ==================================================
     TITLE
  ================================================== */

  product-card .cg-card-title {
    display: -webkit-box;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;

    color: #171717;
    font-size: var(--cg-title-size-mobile);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;

    text-align: left;
    text-decoration: none;
    text-transform: uppercase;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  product-card .cg-card-title:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* ==================================================
     PRICE
  ================================================== */

  product-card .cg-card-price {
    display: block;
    width: 100%;
    margin: var(--cg-title-price-gap-mobile) 0 0;
    padding: 0;
    text-align: left;
  }

  product-card .cg-card-price .price-list {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 7px;

    margin: 0;
    padding: 0;
    text-align: left;
  }

  product-card .cg-card-price sale-price,
  product-card .cg-card-price regular-price,
  product-card .cg-card-price compare-at-price,
  product-card .cg-card-price .price {
    display: inline-block;
    margin: 0;
    padding: 0;

    font-size: var(--cg-price-size-mobile);
    line-height: 1.2;
    letter-spacing: 0;
    text-align: left;
  }

  product-card .cg-card-price regular-price {
    color: #171717;
    font-weight: 400;
  }

  product-card .cg-card-price sale-price {
    font-weight: 400;
  }

  product-card .cg-card-price compare-at-price {
    color: #737373;
    font-weight: 400;
  }

  product-card .cg-card-rating {
    width: 100%;
    margin-top: 9px;
    text-align: left;
  }

  /* ==================================================
     DESKTOP
  ================================================== */

  @media screen and (min-width: 700px) {
    product-card .product-card__info {
      padding-top: var(--cg-info-top-desktop);
    }

    product-card .cg-card-swatches {
      min-height: var(--cg-swatch-size-desktop);
      gap: var(--cg-swatch-gap-desktop);
      margin-bottom: var(--cg-swatch-title-gap-desktop);
    }

    product-card .cg-card-swatches .color-swatch {
      --swatch-size: var(--cg-swatch-size-desktop);

      flex-basis: var(--cg-swatch-size-desktop);

      width: var(--cg-swatch-size-desktop);
      height: var(--cg-swatch-size-desktop);
      min-width: var(--cg-swatch-size-desktop);
      min-height: var(--cg-swatch-size-desktop);
      max-width: var(--cg-swatch-size-desktop);
      max-height: var(--cg-swatch-size-desktop);
    }

    product-card .cg-card-swatch-more {
      height: var(--cg-swatch-size-desktop);
      font-size: var(--cg-more-size-desktop);
    }

    product-card .cg-card-color-count {
      margin-bottom: var(--cg-swatch-title-gap-desktop);
    }

    product-card .cg-card-title {
      font-size: var(--cg-title-size-desktop);
    }

    product-card .cg-card-price {
      margin-top: var(--cg-title-price-gap-desktop);
    }

    product-card .cg-card-price sale-price,
    product-card .cg-card-price regular-price,
    product-card .cg-card-price compare-at-price,
    product-card .cg-card-price .price {
      font-size: var(--cg-price-size-desktop);
    }
  }

  @media screen and (max-width: 699px) {
    product-card .product-media-banner {
      padding: 4px 7px;
    }

    product-card .product-media-banner .banner-heading {
      font-size: 11px !important;
    }
  }
</style>

<product-card
  class="product-card"
  {% if reveal %}
    reveal-on-scroll="true"
  {% endif %}
  handle="{{ product.handle | escape }}"
>
  {%- comment -%}
  --------------------------------------------------------------------------------------------------------------------
  PRODUCT MEDIA
  --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  {%- if product.metafields.custom.badge != blank -%}
    <div
      class="product-media-banner"
      style="
        background-color: {{ section.settings.banner_bg }};
        top: {{ section.settings.banner_position }}px;
        color: {{ section.settings.font_color }};
      "
    >
      <div
        class="banner-heading"
        style="
          font-size: {{ section.settings.banner_heading_size }}px;
          font-weight: 600;
          line-height: 1.3;
        "
      >
        {{ product.metafields.custom.badge }}
      </div>
    </div>
  {%- endif -%}

  {%- if product.media.size > 0 -%}
    <div class="product-card__figure">
      {%- if show_badges -%}
        {%- render 'product-badges',
          product: product,
          vertical: true,
          context: 'card'
        -%}
      {%- endif -%}

      <a
        href="{{ product.url }}"
        class="product-card__media"
        draggable="false"
        data-instant
      >
        {%- capture sizes -%}
          {%- if stacked -%}
            (max-width: 699px) calc(100vw / {{ section.settings.products_per_row_mobile }}), (max-width: 999px) calc(100vw / {{ 3 | at_most: section.settings.products_per_row_desktop | default: 3 }} - 64px), calc((100vw - 96px) / {{ section.settings.products_per_row_desktop | default: 3 }} - (24px / {{ section.settings.products_per_row_desktop | default: 3 }} * {{ section.settings.products_per_row_desktop | default: 3 | minus: 1 }}))
          {%- else -%}
            (max-width: 699px) 74vw, (max-width: 999px) 38vw, calc((100vw - 96px) / {{ section.settings.products_per_row_desktop | default: 3 }} - (24px / {{ section.settings.products_per_row_desktop | default: 3 }} * {{ section.settings.products_per_row_desktop | default: 3 | minus: 1 }}))
          {%- endif -%}
        {%- endcapture -%}

        {%- liquid
          assign main_media_loading_strategy = nil

          if section.index > 3 or position > 3
            assign main_media_loading_strategy = 'lazy'
          endif
        -%}

        {%- capture main_image_classes -%}product-card__image product-card__image--primary {% if settings.product_image_aspect_ratio contains 'crop' %}object-cover{% endif %} aspect-{{ settings.product_image_aspect_ratio | split: '_' | first }}{%- endcapture -%}

        {{-
          product.featured_media
          | image_url: width: product.featured_media.width
          | image_tag:
            loading: main_media_loading_strategy,
            sizes: sizes,
            widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800',
            draggable: 'false',
            class: main_image_classes
        -}}

        {%- liquid
          if show_secondary_image and product.media.size > 1
            assign next_media = product.media[product.featured_media.position] | default: product.media[1]

            if next_media != blank
              echo next_media | image_url: width: next_media.width | image_tag: class: 'product-card__image product-card__image--secondary', loading: 'lazy', fetchpriority: 'low', sizes: sizes, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800', draggable: 'false'
            endif
          endif
        -%}
      </a>

      {%- if show_quick_buy and product.available -%}
        {%- if product.variants.size == 1 and product.selling_plan_groups.size == 0 -%}
          <product-form>
            {%- form 'product', product -%}
              <input type="hidden" name="on_success" value="force_open_drawer">
              <input type="hidden" name="quantity" value="1">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

              <button
                type="submit"
                class="product-card__quick-add-button"
              >
                <span class="sr-only">
                  {{ 'product.general.add_to_cart_button' | t }}
                </span>

                {%- render 'icon' with 'plus' -%}
              </button>
            {%- endform -%}
          </product-form>
        {%- else -%}
          {%- capture quick_buy_id -%}product-quick-buy-{{ section.id }}-{{ block.id }}-{{ quick_buy_context }}-{{ product.id }}{%- endcapture -%}

          <button
            type="button"
            aria-controls="{{ quick_buy_id }}"
            class="product-card__quick-add-button"
          >
            <span class="sr-only">
              {{ 'product.general.choose_options' | t }}
            </span>

            {%- render 'icon' with 'plus' -%}
          </button>

          <quick-buy-modal
            handle="{{ product.handle }}?variant={{ product.selected_or_first_available_variant.id }}"
            class="quick-buy-modal modal"
            id="{{ quick_buy_id }}"
          >
          </quick-buy-modal>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%}
  --------------------------------------------------------------------------------------------------------------------
  PRODUCT INFO
  --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  <div class="product-card__info empty:hidden">
    {%- assign text_class = '' -%}

    {%- if settings.product_card_text_font == 'heading' -%}
      {%- assign text_class = 'h6' -%}
    {%- endif -%}

    <div class="cg-card-information">
      {%- if show_vendor and product.vendor != blank -%}
        {%- capture vendor_class -%}cg-card-vendor smallcaps {% if settings.product_card_text_font == 'heading' %}heading{% endif %}{%- endcapture -%}

        {%- render 'vendor', class: vendor_class -%}
      {%- endif -%}

      {%- if matched_product_option != blank -%}
        {%- case settings.product_color_display -%}
          {%- when 'count' -%}
            <p class="cg-card-color-count">
              {{-
                'product.general.available_colors_count'
                | t: count: matched_product_option.values.size
              -}}
            </p>

          {%- when 'swatch' -%}
            {%- assign hidden_swatch_count = matched_product_option.values.size | minus: cg_visible_swatches -%}

            <fieldset class="cg-card-swatches">
              <legend class="sr-only">
                {{ matched_product_option.name }}
              </legend>

              {%- capture param_name -%}swatch-{{ quick_buy_context }}-{{ section.id }}-{{ block.id }}-{{ product.id }}-{{ matched_product_option.position }}{%- endcapture -%}

              {%- for option_value in matched_product_option.values limit: cg_visible_swatches -%}
                {%- render 'option-value',
                  type: 'swatch',
                  option_value: option_value,
                  param_name: param_name,
                  option_position: matched_product_option.position,
                  output_variant_media: true,
                  size: 'sm'
                -%}
              {%- endfor -%}

              {%- if hidden_swatch_count > 0 -%}
                <span
                  class="cg-card-swatch-more"
                  aria-label="{{ hidden_swatch_count }} additional colours"
                >
                  +{{ hidden_swatch_count }}
                </span>
              {%- endif -%}
            </fieldset>
        {%- endcase -%}
      {%- endif -%}

      {%- if show_title -%}
        <a
          href="{{ product.url }}"
          class="product-title cg-card-title{% if text_class != blank %} {{ text_class }}{% endif %}"
          data-instant
        >
          {{- product.title -}}
        </a>
      {%- endif -%}

      {%- if show_prices -%}
        <div class="cg-card-price">
          {%- render 'price-list',
            product: product,
            context: 'card'
          -%}
        </div>
      {%- endif -%}

      {%- if show_rating -%}
        <div class="cg-card-rating">
          {%- render 'product-rating',
            product: product,
            show_empty: settings.show_product_rating_if_empty,
            display_mode: settings.product_rating_mode
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</product-card>{%- comment -%}

