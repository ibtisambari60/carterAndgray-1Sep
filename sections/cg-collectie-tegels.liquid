{% comment %}
  CG Collectie Tegels
  Editorial collection grid for Shopify Prestige.
  Mobile: 2 columns. Desktop: 4 columns.
  All images are forced into the same 3:4 crop.
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --cg-bg: {{ section.settings.background_color }};
    --cg-text: {{ section.settings.text_color }};
    --cg-mobile-top: {{ section.settings.mobile_padding_top }}px;
    --cg-mobile-side: {{ section.settings.mobile_side_padding }}px;
    --cg-mobile-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --cg-mobile-column-gap: {{ section.settings.mobile_column_gap }}px;
    --cg-mobile-row-gap: {{ section.settings.mobile_row_gap }}px;
    --cg-desktop-top: {{ section.settings.desktop_padding_top }}px;
    --cg-desktop-side: {{ section.settings.desktop_side_padding }}px;
    --cg-desktop-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --cg-desktop-column-gap: {{ section.settings.desktop_column_gap }}px;
    --cg-desktop-row-gap: {{ section.settings.desktop_row_gap }}px;
  }

  #shopify-section-{{ section.id }} .cg-collection-grid {
    width: 100%;
    overflow: hidden;
    background: var(--cg-bg);
    color: var(--cg-text);
  }

  #shopify-section-{{ section.id }} .cg-collection-grid__inner {
    width: 100%;
    margin: 0 auto;
    padding: var(--cg-mobile-top) var(--cg-mobile-side) var(--cg-mobile-bottom);
  }

  #shopify-section-{{ section.id }} .cg-collection-grid__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--cg-mobile-column-gap);
    row-gap: var(--cg-mobile-row-gap);
    align-items: start;
  }

  #shopify-section-{{ section.id }} .cg-collection-card {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cg-collection-card__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 100 / 118;
    overflow: hidden;
    background: #f3f2ef;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .cg-collection-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cg-image-position, center center);
    transform: scale(1.001);
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #shopify-section-{{ section.id }} .cg-collection-card__placeholder,
  #shopify-section-{{ section.id }} .cg-collection-card__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .cg-collection-card__placeholder svg {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .cg-collection-card__content {
    min-width: 0;
    padding-top: {{ section.settings.mobile_image_title_gap }}px;
  }

 #shopify-section-{{ section.id }} .cg-collection-card__title {
  margin: 0;
  padding: 0;
  color: var(--cg-text);
  font-family: var(--text-font-family, Arial, Helvetica, sans-serif);
  font-size: {{ section.settings.mobile_title_size }}px;
  font-style: normal;
  font-weight: {{ section.settings.default_title_weight }} !important;
  line-height: {{ section.settings.title_line_height }}%;
  letter-spacing: calc(
    {{ section.settings.title_letter_spacing }} / 100 * 1em
  );
  text-transform:
    {% if section.settings.uppercase_titles %}
      uppercase
    {% else %}
      none
    {% endif %};

  font-synthesis: weight;

  {% case section.settings.default_title_weight %}
    {% when '500' %}
      -webkit-text-stroke: 0.12px currentColor;
      text-shadow: 0 0 0.01px currentColor;
    {% when '600' %}
-webkit-text-stroke: 0.10px currentColor;
text-shadow: none;
    {% when '700' %}
      -webkit-text-stroke: 0.45px currentColor;
      text-shadow: 0 0 0.01px currentColor;
    {% else %}
      -webkit-text-stroke: 0;
      text-shadow: none;
  {% endcase %}
}

  #shopify-section-{{ section.id }} .cg-collection-card__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: {{ section.settings.mobile_link_gap }}px;
    margin-top: {{ section.settings.mobile_title_link_gap }}px;
  }

  #shopify-section-{{ section.id }} .cg-collection-card__link {
    position: relative;
    display: inline-block;
    width: fit-content;
    max-width: 100%;
    margin: 0;
    padding: 0 0 {{ section.settings.underline_offset }}px;
    color: var(--cg-text);
    font-family: var(--text-font-family, Arial, Helvetica, sans-serif);
    font-size: {{ section.settings.mobile_link_size }}px;
    font-style: normal;
    font-weight: {{ section.settings.link_weight }};
    line-height: {{ section.settings.link_line_height }}%;
    letter-spacing: calc({{ section.settings.link_letter_spacing }} / 100 * 1em);
    text-decoration: none;
    white-space: nowrap;
    text-transform: {% if section.settings.uppercase_links %}uppercase{% else %}none{% endif %};
  }

  #shopify-section-{{ section.id }} .cg-collection-card__link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: {{ section.settings.underline_thickness }}px;
    background: currentColor;
  }

  {% if section.settings.enable_image_zoom %}
    #shopify-section-{{ section.id }} .cg-collection-card__media:hover .cg-collection-card__image {
      transform: scale(1.025);
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cg-collection-grid__inner {
      {% unless section.settings.full_width %}
        max-width: {{ section.settings.maximum_width }}px;
      {% endunless %}

      padding: var(--cg-desktop-top) var(--cg-desktop-side) var(--cg-desktop-bottom);
    }

    #shopify-section-{{ section.id }} .cg-collection-grid__items {
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
      column-gap: var(--cg-desktop-column-gap);
      row-gap: var(--cg-desktop-row-gap);
    }

    #shopify-section-{{ section.id }} .cg-collection-card__content {
      padding-top: {{ section.settings.desktop_image_title_gap }}px;
    }

    #shopify-section-{{ section.id }} .cg-collection-card__title {
      font-size: {{ section.settings.desktop_title_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-collection-card__links {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      column-gap: {{ section.settings.desktop_link_horizontal_gap }}px;
      row-gap: {{ section.settings.desktop_link_vertical_gap }}px;
      margin-top: {{ section.settings.desktop_title_link_gap }}px;
    }

    #shopify-section-{{ section.id }} .cg-collection-card__link {
      font-size: {{ section.settings.desktop_link_size }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .cg-collection-card__image {
      transition: none;
    }
  }
{%- endstyle -%}

<section
  class="cg-collection-grid"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="cg-collection-grid__inner">
    <div class="cg-collection-grid__items">
      {%- for block in section.blocks -%}
        {%- liquid
          assign media_link = block.settings.image_link

          if media_link == blank
            assign media_link = block.settings.link_1
          endif

          assign image_alt = block.settings.image.alt

          if image_alt == blank
            assign image_alt = block.settings.title
          endif
-%}
       <article
  class="cg-collection-card"
  {{ block.shopify_attributes }}
>
          {%- if media_link != blank -%}
            <a
              class="cg-collection-card__media"
              href="{{ media_link }}"
              aria-label="{{ block.settings.title | escape }}"
              style="--cg-image-position: {{ block.settings.image_position }};"
            >
          {%- else -%}
            <div
              class="cg-collection-card__media"
              style="--cg-image-position: {{ block.settings.image_position }};"
            >
          {%- endif -%}

            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 2000
                | image_tag:
                  class: 'cg-collection-card__image',
                  loading: 'lazy',
                  widths: '240, 320, 400, 480, 600, 720, 900, 1100, 1400, 1700, 2000',
                  sizes: '(max-width: 749px) calc(50vw - 18px), 25vw',
                  alt: image_alt
              }}
            {%- else -%}
              <div class="cg-collection-card__placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}

          {%- if media_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}

          <div class="cg-collection-card__content">
            {%- if block.settings.title != blank -%}
              <h2 class="cg-collection-card__title">
                {{ block.settings.title }}
              </h2>
            {%- endif -%}

            {%- if block.settings.link_label_1 != blank or block.settings.link_label_2 != blank -%}
              <div class="cg-collection-card__links">
                {%- if block.settings.link_label_1 != blank -%}
                  {%- if block.settings.link_1 != blank -%}
                    <a
                      class="cg-collection-card__link"
                      href="{{ block.settings.link_1 }}"
                    >
                      {{ block.settings.link_label_1 }}
                    </a>
                  {%- else -%}
                    <span class="cg-collection-card__link">
                      {{ block.settings.link_label_1 }}
                    </span>
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.link_label_2 != blank -%}
                  {%- if block.settings.link_2 != blank -%}
                    <a
                      class="cg-collection-card__link"
                      href="{{ block.settings.link_2 }}"
                    >
                      {{ block.settings.link_label_2 }}
                    </a>
                  {%- else -%}
                    <span class="cg-collection-card__link">
                      {{ block.settings.link_label_2 }}
                    </span>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

