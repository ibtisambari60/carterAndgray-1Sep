{% schema %}
{
  "name": "Announcement Discounts",
  "tag": "section",
  "class": "announcement-discounts",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#dddddd"
    },
    {
      "type": "color",
      "id": "block_bg",
      "label": "Block Background Color"
    },
    {
      "type": "color",
      "id": "block_text",
      "label": "Block Text Color",
      "default": "#2F3E46"
    },
    {
      "type": "color",
      "id": "block_border",
      "label": "Block Border Color",
      "default": "#2F3E46"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "-10%"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Announcement Discounts"
    }
  ]
}
{% endschema %}

<div class="custom-carousel-announcement" style="background-color: {{ section.settings.background_color }}; border-top: 1px solid {{ section.settings.border_color }}; border-bottom: 1px solid {{ section.settings.border_color }};">
  <div class="custom-carousel-inner">
    {% for block in section.blocks %}
      <div class="announcement-block">
        <div class="announcement-title">{{ block.settings.title }}</div>
        <p class="announcement-subtitle">{{ block.settings.subtitle }}</p>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .custom-carousel-announcement {
    width: 100%;
    box-shadow: 0px 5px 20px -10px rgba(0, 0, 0, 0.15);
    z-index: 9;
  }

  .custom-carousel-inner {
    display: flex;
    justify-content: center;
    align-items: center;
    color: #29252B;
    gap: 15px;
    padding: 5px 16px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
    flex-wrap: nowrap;
  }

  .announcement-block {
    text-align: center;
    flex: 1 1 0;
    min-width: 0;
    padding: 8px 0;
    border: 1px solid {{ section.settings.block_border }};
    background-color: {{ section.settings.block_bg }};
  }

  .announcement-title {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 4px;
    color: {{ section.settings.block_text }}!important;
  }

  .announcement-subtitle {
    font-size: 10.5px;
    font-weight: 500;
    white-space: nowrap;
    margin-top: -20px;
    padding-top: 8px;
    color: {{ section.settings.block_text }}!important;
    text-wrap: auto;
  }

  .announcement-subtitle strong {
    font-size: 12.5px;
  }

  @media (max-width: 767px) {
    .custom-carousel-inner {
      gap: 5px;
      padding: 5px 9px;
    }

    .announcement-title {
      font-size: 17px;
    }

    .announcement-subtitle {
      font-size: 10.5px;
      font-weight: 500 !important;
    }

    .announcement-subtitle strong {
      font-size: 12.5px;
    }

    /* REMOVE sticky bar */
    .mobile-fixed-bar {
      position: static !important;
      top: auto;
      box-shadow: none;
    }
  }
</style>