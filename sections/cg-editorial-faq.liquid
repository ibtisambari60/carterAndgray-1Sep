{% comment %}
  CG Editorial FAQ
  Premium editorial FAQ-section voor Shopify Prestige.

  Advies:
  Maak dit als nieuwe section aan en laat de bestaande FAQ staan
  totdat deze versie volledig is ingericht.
{% endcomment %}

{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.question_font | font_face: font_display: 'swap' }}
  {{ section.settings.answer_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    --cg-faq-background: {{ section.settings.background_color }};
    --cg-faq-heading-color: {{ section.settings.heading_color }};
    --cg-faq-question-color: {{ section.settings.question_color }};
    --cg-faq-answer-color: {{ section.settings.answer_color }};
    --cg-faq-line-color: {{ section.settings.line_color }};
    --cg-faq-icon-color: {{ section.settings.icon_color }};
    --cg-faq-content-width: {{ section.settings.content_width }}px;
    --cg-faq-mobile-side-padding: {{ section.settings.mobile_side_padding }}px;
    --cg-faq-desktop-side-padding: {{ section.settings.desktop_side_padding }}px;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq,
  #shopify-section-{{ section.id }} .cg-editorial-faq * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq {
    width: 100%;
    background: var(--cg-faq-background);
    color: var(--cg-faq-question-color);
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__inner {
    width: 100%;
    max-width: calc(
      var(--cg-faq-content-width)
      + (2 * var(--cg-faq-mobile-side-padding))
    );
    margin: 0 auto;
    padding:
      {{ section.settings.mobile_padding_top }}px
      var(--cg-faq-mobile-side-padding)
      {{ section.settings.mobile_padding_bottom }}px;
  }

  /* =========================
     HEADER
  ========================= */

  #shopify-section-{{ section.id }} .cg-editorial-faq__header {
    max-width: {{ section.settings.header_width }}px;
    margin-bottom: {{ section.settings.mobile_header_items_gap }}px;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__eyebrow {
    display: block;
    margin: 0 0 {{ section.settings.eyebrow_heading_gap }}px;
    color: {{ section.settings.eyebrow_color }};

    font-family:
      {{ section.settings.question_font.family }},
      {{ section.settings.question_font.fallback_families }};

    font-size: {{ section.settings.mobile_eyebrow_size }}px;
    font-style: {{ section.settings.question_font.style }};
    font-weight: {{ section.settings.eyebrow_weight }};
    line-height: 1.2;
    letter-spacing: calc(
      {{ section.settings.eyebrow_letter_spacing }} / 100 * 1em
    );

    {% if section.settings.uppercase_eyebrow %}
      text-transform: uppercase;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__heading {
    margin: 0;
    padding: 0;
    color: var(--cg-faq-heading-color);

    font-family:
      {{ section.settings.heading_font.family }},
      {{ section.settings.heading_font.fallback_families }};

    font-size: {{ section.settings.mobile_heading_size }}px;
    font-style: {{ section.settings.heading_font.style }};
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height }}%;
    letter-spacing: calc(
      {{ section.settings.heading_letter_spacing }} / 100 * 1em
    );
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__intro {
    max-width: {{ section.settings.intro_width }}px;
    margin:
      {{ section.settings.heading_intro_gap }}px
      0
      0;
    color: var(--cg-faq-answer-color);

    font-family:
      {{ section.settings.answer_font.family }},
      {{ section.settings.answer_font.fallback_families }};

    font-size: {{ section.settings.mobile_intro_size }}px;
    font-style: {{ section.settings.answer_font.style }};
    font-weight: {{ section.settings.intro_weight }};
    line-height: {{ section.settings.intro_line_height }}%;
    letter-spacing: calc(
      {{ section.settings.intro_letter_spacing }} / 100 * 1em
    );
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__intro p {
    margin: 0;
  }

  /* =========================
     FAQ ITEMS
  ========================= */

  #shopify-section-{{ section.id }} .cg-editorial-faq__list {
    width: 100%;
    border-top:
      {{ section.settings.line_thickness }}px
      solid
      var(--cg-faq-line-color);
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__item {
    margin: 0;
    border-bottom:
      {{ section.settings.line_thickness }}px
      solid
      var(--cg-faq-line-color);
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    width: 100%;
    align-items: center;
    gap: {{ section.settings.question_icon_gap }}px;
    padding:
      {{ section.settings.mobile_question_padding }}px
      0;
    color: var(--cg-faq-question-color);
    cursor: pointer;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__summary::marker {
    display: none;
    content: "";
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__question {
    margin: 0;
    padding: 0;

    font-family:
      {{ section.settings.question_font.family }},
      {{ section.settings.question_font.fallback_families }};

    font-size: {{ section.settings.mobile_question_size }}px;
    font-style: {{ section.settings.question_font.style }};
    font-weight: {{ section.settings.question_weight }};
    line-height: {{ section.settings.question_line_height }}%;
    letter-spacing: calc(
      {{ section.settings.question_letter_spacing }} / 100 * 1em
    );
  }

  /* =========================
     PLUS / MINUS
  ========================= */

  #shopify-section-{{ section.id }} .cg-editorial-faq__icon {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    color: var(--cg-faq-icon-color);
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__icon::before,
  #shopify-section-{{ section.id }} .cg-editorial-faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: {{ section.settings.icon_line_length }}%;
    height: {{ section.settings.icon_line_thickness }}px;
    background: currentColor;
    transform:
      translate(-50%, -50%);
    transform-origin: center;
    transition:
      opacity 220ms ease,
      transform 220ms ease;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__icon::after {
    transform:
      translate(-50%, -50%)
      rotate(90deg);
  }

  #shopify-section-{{ section.id }} details[open]
    .cg-editorial-faq__icon::after {
    opacity: 0;
    transform:
      translate(-50%, -50%)
      rotate(0deg);
  }

  /* =========================
     ANSWER
  ========================= */

  #shopify-section-{{ section.id }} .cg-editorial-faq__answer {
    max-width: {{ section.settings.answer_width }}px;
    padding:
      0
      {{ section.settings.answer_right_padding }}px
      {{ section.settings.mobile_answer_bottom_padding }}px
      0;
    color: var(--cg-faq-answer-color);

    font-family:
      {{ section.settings.answer_font.family }},
      {{ section.settings.answer_font.fallback_families }};

    font-size: {{ section.settings.mobile_answer_size }}px;
    font-style: {{ section.settings.answer_font.style }};
    font-weight: {{ section.settings.answer_weight }};
    line-height: {{ section.settings.answer_line_height }}%;
    letter-spacing: calc(
      {{ section.settings.answer_letter_spacing }} / 100 * 1em
    );
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__answer > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__answer > *:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__answer p {
    margin:
      0
      0
      {{ section.settings.answer_paragraph_gap }}px;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__answer a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__summary:hover
    .cg-editorial-faq__question {
    {% if section.settings.question_hover_underline %}
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 5px;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__summary:focus-visible {
    outline: 1px solid var(--cg-faq-question-color);
    outline-offset: 6px;
  }

  /* =========================
     OPTIONAL FOOTER
  ========================= */

  #shopify-section-{{ section.id }} .cg-editorial-faq__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: {{ section.settings.footer_text_button_gap }}px;
    margin-top: {{ section.settings.mobile_list_footer_gap }}px;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__footer-text {
    margin: 0;
    color: var(--cg-faq-answer-color);

    font-family:
      {{ section.settings.answer_font.family }},
      {{ section.settings.answer_font.fallback_families }};

    font-size: {{ section.settings.mobile_footer_size }}px;
    font-style: {{ section.settings.answer_font.style }};
    font-weight: {{ section.settings.footer_weight }};
    line-height: {{ section.settings.footer_line_height }}%;
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__button {
    display: inline-flex;
    min-height: {{ section.settings.button_height }}px;
    align-items: center;
    justify-content: center;
    padding:
      0
      {{ section.settings.button_horizontal_padding }}px;
    border:
      {{ section.settings.button_border_width }}px
      solid
      {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_radius }}px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};

    font-family:
      {{ section.settings.question_font.family }},
      {{ section.settings.question_font.fallback_families }};

    font-size: {{ section.settings.button_text_size }}px;
    font-style: {{ section.settings.question_font.style }};
    font-weight: {{ section.settings.button_weight }};
    line-height: 1;
    letter-spacing: calc(
      {{ section.settings.button_letter_spacing }} / 100 * 1em
    );

    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease;

    {% if section.settings.uppercase_button %}
      text-transform: uppercase;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .cg-editorial-faq__button:hover {
    background: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_border_color }};
  }

  /* =========================
     DESKTOP
  ========================= */

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cg-editorial-faq__inner {
      max-width: calc(
        var(--cg-faq-content-width)
        + (2 * var(--cg-faq-desktop-side-padding))
      );
      padding:
        {{ section.settings.desktop_padding_top }}px
        var(--cg-faq-desktop-side-padding)
        {{ section.settings.desktop_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .cg-editorial-faq__header {
      margin-bottom: {{ section.settings.desktop_header_items_gap }}px;
    }

    #shopify-section-{{ section.id }} .cg-editorial-faq__eyebrow {
      font-size: {{ section.settings.desktop_eyebrow_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-editorial-faq__heading {
      font-size: {{ section.settings.desktop_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-editorial-faq__intro {
      font-size: {{ section.settings.desktop_intro_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-editorial-faq__summary {
      padding:
        {{ section.settings.desktop_question_padding }}px
        0;
    }

    #shopify-section-{{ section.id }} .cg-editorial-faq__question {
      font-size: {{ section.settings.desktop_question_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-editorial-faq__answer {
      padding-bottom:
        {{ section.settings.desktop_answer_bottom_padding }}px;
      font-size: {{ section.settings.desktop_answer_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-editorial-faq__footer {
      margin-top: {{ section.settings.desktop_list_footer_gap }}px;
    }

    #shopify-section-{{ section.id }} .cg-editorial-faq__footer-text {
      font-size: {{ section.settings.desktop_footer_size }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .cg-editorial-faq__icon::before,
    #shopify-section-{{ section.id }} .cg-editorial-faq__icon::after,
    #shopify-section-{{ section.id }} .cg-editorial-faq__button {
      transition: none;
    }
  }
{%- endstyle -%}

<section
  class="cg-editorial-faq"
  aria-labelledby="CGEditorialFaqHeading-{{ section.id }}"
>
  <div class="cg-editorial-faq__inner">

    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.intro != blank
    -%}
      <header class="cg-editorial-faq__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="cg-editorial-faq__eyebrow">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2
            id="CGEditorialFaqHeading-{{ section.id }}"
            class="cg-editorial-faq__heading"
          >
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="cg-editorial-faq__intro rte">
            {{ section.settings.intro }}
          </div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="cg-editorial-faq__list">
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank -%}
          <details
            class="cg-editorial-faq__item"
            {% if block.settings.open_by_default %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="cg-editorial-faq__summary">
              <span class="cg-editorial-faq__question">
                {{ block.settings.question }}
              </span>

              <span
                class="cg-editorial-faq__icon"
                aria-hidden="true"
              ></span>
            </summary>

            {%- if block.settings.answer != blank -%}
              <div class="cg-editorial-faq__answer rte">
                {{ block.settings.answer }}
              </div>
            {%- endif -%}
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.footer_text != blank
      or section.settings.button_label != blank
    -%}
      <div class="cg-editorial-faq__footer">
        {%- if section.settings.footer_text != blank -%}
          <p class="cg-editorial-faq__footer-text">
            {{ section.settings.footer_text }}
          </p>
        {%- endif -%}

        {%- if section.settings.button_label != blank
          and section.settings.button_link != blank
        -%}
          <a
            href="{{ section.settings.button_link }}"
            class="cg-editorial-faq__button"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "CG Editorial FAQ",
  "tag": "section",
  "class": "section-cg-editorial-faq",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Inhoud"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Boventitel",
      "default": "Customer care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introductie",
      "default": "<p>Everything you need to know about delivery, returns and ordering.</p>"
    },
    {
      "type": "range",
      "id": "header_width",
      "label": "Maximale breedte titelblok",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 700
    },
    {
      "type": "range",
      "id": "intro_width",
      "label": "Maximale breedte introductie",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 620
    },

    {
      "type": "header",
      "content": "Titeltypografie"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Lettertype titel",
      "default": "times_new_roman_n4"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Titelgrootte mobiel",
      "min": 28,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "label": "Titelgrootte desktop",
      "min": 36,
      "max": 84,
      "step": 1,
      "unit": "px",
      "default": 58
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Dikte titel",
      "options": [
        {
          "value": "300",
          "label": "Licht"
        },
        {
          "value": "400",
          "label": "Normaal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Regelhoogte titel",
      "min": 85,
      "max": 140,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letterafstand titel",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "%",
      "default": 0
    },

    {
      "type": "header",
      "content": "Boventitel en introductie"
    },
    {
      "type": "font_picker",
      "id": "answer_font",
      "label": "Lettertype introductie en antwoorden",
      "default": "helvetica_n4"
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_size",
      "label": "Boventitel mobiel",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "desktop_eyebrow_size",
      "label": "Boventitel desktop",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "eyebrow_weight",
      "label": "Dikte boventitel",
      "options": [
        {
          "value": "400",
          "label": "Normaal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Vet"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "eyebrow_letter_spacing",
      "label": "Letterafstand boventitel",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "uppercase_eyebrow",
      "label": "Boventitel in hoofdletters",
      "default": true
    },
    {
      "type": "range",
      "id": "eyebrow_heading_gap",
      "label": "Ruimte boventitel naar titel",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_intro_size",
      "label": "Introductiegrootte mobiel",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "desktop_intro_size",
      "label": "Introductiegrootte desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "intro_weight",
      "label": "Dikte introductie",
      "options": [
        {
          "value": "300",
          "label": "Licht"
        },
        {
          "value": "400",
          "label": "Normaal"
        },
        {
          "value": "500",
          "label": "Medium"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "intro_line_height",
      "label": "Regelhoogte introductie",
      "min": 120,
      "max": 190,
      "step": 2,
      "unit": "%",
      "default": 156
    },
    {
      "type": "range",
      "id": "intro_letter_spacing",
      "label": "Letterafstand introductie",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_intro_gap",
      "label": "Ruimte titel naar introductie",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },

    {
      "type": "header",
      "content": "Vraagtypografie"
    },
    {
      "type": "font_picker",
      "id": "question_font",
      "label": "Lettertype vragen",
      "default": "helvetica_n4"
    },
    {
      "type": "range",
      "id": "mobile_question_size",
      "label": "Vraaggrootte mobiel",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "desktop_question_size",
      "label": "Vraaggrootte desktop",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "question_weight",
      "label": "Dikte vragen",
      "options": [
        {
          "value": "300",
          "label": "Licht"
        },
        {
          "value": "400",
          "label": "Normaal"
        },
