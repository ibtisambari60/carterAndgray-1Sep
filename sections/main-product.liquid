{%- liquid
  assign has_content_below_gallery = false
  assign cg_variant_picker_block = section.blocks | where: 'type', 'variant_picker' | first

  for block in section.blocks
    if block.type == 'complementary_products'
      assign has_content_below_gallery = true
      break
    endif

    unless block.settings.show_below_gallery
      continue
    endunless

    if block.type == 'accordion' and block.settings.title != blank and block.settings.content != blank or block.settings.liquid != blank or block.settings.page.content != blank
      assign has_content_below_gallery = true
      break
    elsif block.type == 'description' and product.description != blank
      assign has_content_below_gallery = true
      break
    endif
  endfor
-%}

<style>
  #shopify-section-{{ section.id }} {
    --product-grid: "product-gallery" "product-info" {% if has_content_below_gallery %}"product-content"{% endif %} / minmax(0, 1fr);
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- if has_content_below_gallery -%}
        --product-grid: "product-gallery product-info" auto "product-content product-info" minmax(0, 1fr) / minmax(0, {{ 100.0 | minus: section.settings.product_info_size | divided_by: 100.0 }}fr) minmax(0, {{ section.settings.product_info_size | divided_by: 100.0 }}fr);
      {%- else -%}
        --product-grid: "product-gallery product-info" / minmax(0, {{ 100.0 | minus: section.settings.product_info_size | divided_by: 100.0 }}fr) minmax(0, {{ section.settings.product_info_size | divided_by: 100.0 }}fr);
      {%- endif -%}
    }
  }
    /* =========================================================
     CARTER & GRAY ‚Äö√Ñ√Æ PREMIUM NATIVE VARIANT PICKER
  ========================================================= */

  #shopify-section-{{ section.id }} {
    --cg-option-label-size: {{ cg_variant_picker_block.settings.cg_option_label_size | default: 15 }}px;
    --cg-option-label-weight: {{ cg_variant_picker_block.settings.cg_option_label_weight | default: 500 }};
    --cg-option-label-bottom: {{ cg_variant_picker_block.settings.cg_option_label_bottom | default: 10 }}px;
    --cg-option-spacing: {{ cg_variant_picker_block.settings.cg_option_spacing | default: 26 }}px;

    --cg-thumb-width-mobile: {{ cg_variant_picker_block.settings.cg_thumb_width_mobile | default: 72 }}px;
    --cg-thumb-height-mobile: {{ cg_variant_picker_block.settings.cg_thumb_height_mobile | default: 92 }}px;
    --cg-thumb-width-desktop: {{ cg_variant_picker_block.settings.cg_thumb_width_desktop | default: 90 }}px;
    --cg-thumb-height-desktop: {{ cg_variant_picker_block.settings.cg_thumb_height_desktop | default: 116 }}px;
    --cg-thumb-gap: {{ cg_variant_picker_block.settings.cg_thumb_gap | default: 8 }}px;
    --cg-thumb-padding: {{ cg_variant_picker_block.settings.cg_thumb_padding | default: 4 }}px;
    --cg-thumb-radius: {{ cg_variant_picker_block.settings.cg_thumb_radius | default: 0 }}px;
    --cg-thumb-border-width: {{ cg_variant_picker_block.settings.cg_thumb_border_width | default: 1 }}px;
    --cg-thumb-selected-width: {{ cg_variant_picker_block.settings.cg_thumb_selected_width | default: 2 }}px;
    --cg-thumb-border-color: {{ cg_variant_picker_block.settings.cg_thumb_border_color | default: '#D5D5D5' }};
    --cg-thumb-selected-color: {{ cg_variant_picker_block.settings.cg_thumb_selected_color | default: '#171717' }};
    --cg-thumb-background: {{ cg_variant_picker_block.settings.cg_thumb_background | default: '#F7F7F5' }};

    --cg-size-min-width-mobile: {{ cg_variant_picker_block.settings.cg_size_min_width_mobile | default: 52 }}px;
    --cg-size-min-width-desktop: {{ cg_variant_picker_block.settings.cg_size_min_width_desktop | default: 58 }}px;
    --cg-size-height: {{ cg_variant_picker_block.settings.cg_size_height | default: 48 }}px;
    --cg-size-gap: {{ cg_variant_picker_block.settings.cg_size_gap | default: 8 }}px;
    --cg-size-font: {{ cg_variant_picker_block.settings.cg_size_font | default: 14 }}px;
    --cg-size-weight: {{ cg_variant_picker_block.settings.cg_size_weight | default: 400 }};
    --cg-size-radius: {{ cg_variant_picker_block.settings.cg_size_radius | default: 0 }}px;
    --cg-size-border-width: {{ cg_variant_picker_block.settings.cg_size_border_width | default: 1 }}px;
    --cg-size-border-color: {{ cg_variant_picker_block.settings.cg_size_border_color | default: '#CECECE' }};
    --cg-size-text-color: {{ cg_variant_picker_block.settings.cg_size_text_color | default: '#555555' }};
    --cg-size-background: {{ cg_variant_picker_block.settings.cg_size_background | default: '#FFFFFF' }};
    --cg-size-selected-background: {{ cg_variant_picker_block.settings.cg_size_selected_background | default: '#252525' }};
    --cg-size-selected-text: {{ cg_variant_picker_block.settings.cg_size_selected_text | default: '#FFFFFF' }};
    --cg-size-selected-border: {{ cg_variant_picker_block.settings.cg_size_selected_border | default: '#252525' }};

    --cg-size-chart-font: {{ cg_variant_picker_block.settings.cg_size_chart_font | default: 14 }}px;
    --cg-size-chart-weight: {{ cg_variant_picker_block.settings.cg_size_chart_weight | default: 500 }};
  }

  #shopify-section-{{ section.id }} variant-picker {
    display: block;
    width: 100%;
  }

  #shopify-section-{{ section.id }} variant-picker fieldset {
  display: block !important;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  gap: 0 !important;
  row-gap: 0 !important;
}

#shopify-section-{{ section.id }} variant-picker fieldset + fieldset {
  margin-top: calc(var(--cg-option-spacing) * 0.55) !important;
}

#shopify-section-{{ section.id }} variant-picker .variant-picker__option-info {
  display: flex !important;
  width: 100%;
  align-items: baseline;
  justify-content: flex-start !important;
  gap: 5px;
  margin: 0 0 var(--cg-option-label-bottom) !important;
  padding: 0;
  color: #171717;
  font-size: var(--cg-option-label-size);
  line-height: 1.2;
  letter-spacing: 0;
  text-transform: none;
}

#shopify-section-{{ section.id }} variant-picker .variant-picker__option-info legend,
#shopify-section-{{ section.id }} variant-picker .variant-picker__option-info > span:first-child {
  width: auto !important;
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
  font-weight: var(--cg-option-label-weight);
}

#shopify-section-{{ section.id }} variant-picker .variant-picker__option-info > span:not(:first-child) {
  width: auto !important;
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
  font-weight: 400 !important;
}

#shopify-section-{{ section.id }} variant-picker .variant-picker__option-values {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

  #shopify-section-{{ section.id }} variant-picker .variant-picker__option-values {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} variant-picker .variant-picker__option-values:has(.thumbnail-swatch) {
    gap: var(--cg-thumb-gap);
  }

  #shopify-section-{{ section.id }} variant-picker .thumbnail-swatch {
    position: relative;
    display: flex;
    flex: 0 0 var(--cg-thumb-width-mobile);
    width: var(--cg-thumb-width-mobile);
    height: var(--cg-thumb-height-mobile);
    min-width: var(--cg-thumb-width-mobile);
    min-height: var(--cg-thumb-height-mobile);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin: 0;
    padding: var(--cg-thumb-padding);
    border: var(--cg-thumb-border-width) solid var(--cg-thumb-border-color);
    border-radius: var(--cg-thumb-radius);
    background: var(--cg-thumb-background);
    box-shadow: none;
    box-sizing: border-box;
    cursor: pointer;
    transition: border-color 150ms ease, box-shadow 150ms ease, opacity 150ms ease;
  }

  #shopify-section-{{ section.id }} variant-picker .thumbnail-swatch img,
  #shopify-section-{{ section.id }} variant-picker .thumbnail-swatch .cg-variant-image {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: contain !important;
    object-position: center;
    background: transparent;
  }

  #shopify-section-{{ section.id }} variant-picker input:checked + .thumbnail-swatch,
  #shopify-section-{{ section.id }} variant-picker .thumbnail-swatch.is-selected {
    border-width: var(--cg-thumb-selected-width);
    border-color: var(--cg-thumb-selected-color);
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} variant-picker .thumbnail-swatch:hover {
    border-color: var(--cg-thumb-selected-color);
  }

  #shopify-section-{{ section.id }} variant-picker .thumbnail-swatch.is-disabled {
    opacity: 0.42;
  }

#shopify-section-{{ section.id }} variant-picker .variant-picker__option-values:has(.block-swatch) {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--cg-size-gap);
  margin: 0 !important;
  padding: 0 !important;
}

#shopify-section-{{ section.id }} variant-picker .block-swatch {
  display: inline-flex !important;
  flex: 0 0 var(--cg-size-min-width-mobile) !important;

  width: var(--cg-size-min-width-mobile) !important;
  min-width: var(--cg-size-min-width-mobile) !important;
  max-width: var(--cg-size-min-width-mobile) !important;

  height: var(--cg-size-height) !important;
  min-height: var(--cg-size-height) !important;
  max-height: var(--cg-size-height) !important;

  block-size: var(--cg-size-height) !important;
  min-block-size: var(--cg-size-height) !important;
  max-block-size: var(--cg-size-height) !important;

  align-items: center !important;
  justify-content: center !important;

  margin: 0 !important;
  padding: 0 4px !important;
  padding-block: 0 !important;

  border: var(--cg-size-border-width) solid var(--cg-size-border-color);
  border-radius: var(--cg-size-radius);
  background: var(--cg-size-background);
  color: var(--cg-size-text-color);
  box-shadow: none;
  box-sizing: border-box;

  font-size: var(--cg-size-font);
  font-weight: var(--cg-size-weight);
  line-height: 1 !important;
  letter-spacing: 0;
  text-align: center;
  white-space: nowrap;
  text-transform: none;

  cursor: pointer;
  transition:
    color 150ms ease,
    background-color 150ms ease,
    border-color 150ms ease;
}

#shopify-section-{{ section.id }} variant-picker input:checked + .block-swatch,
#shopify-section-{{ section.id }} variant-picker .block-swatch.is-selected {
  border-color: var(--cg-size-selected-border);
  background: var(--cg-size-selected-background);
  color: var(--cg-size-selected-text);
}

#shopify-section-{{ section.id }} variant-picker .block-swatch:hover {
  border-color: var(--cg-size-selected-border);
}

#shopify-section-{{ section.id }} variant-picker .block-swatch.is-disabled {
  opacity: 0.38;
  text-decoration: line-through;
}

  #shopify-section-{{ section.id }} variant-picker a[href*="size"],
  #shopify-section-{{ section.id }} variant-picker button[aria-controls*="size"],
  #shopify-section-{{ section.id }} variant-picker .variant-picker__size-chart {
    color: #171717;
    font-size: var(--cg-size-chart-font);
    font-weight: var(--cg-size-chart-weight);
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} variant-picker .thumbnail-swatch {
      flex-basis: var(--cg-thumb-width-desktop);
      width: var(--cg-thumb-width-desktop);
      height: var(--cg-thumb-height-desktop);
      min-width: var(--cg-thumb-width-desktop);
      min-height: var(--cg-thumb-height-desktop);
    }

 #shopify-section-{{ section.id }} variant-picker .block-swatch {
  flex-basis: var(--cg-size-min-width-desktop) !important;
  width: var(--cg-size-min-width-desktop) !important;
  min-width: var(--cg-size-min-width-desktop) !important;
  max-width: var(--cg-size-min-width-desktop) !important;

  height: var(--cg-size-height) !important;
  min-height: var(--cg-size-height) !important;
  max-height: var(--cg-size-height) !important;

  block-size: var(--cg-size-height) !important;
  min-block-size: var(--cg-size-height) !important;
  max-block-size: var(--cg-size-height) !important;
}
</style>

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}
{%- capture product_form_id -%}product-form-main-{{ product.id }}-{{ section.id }}{%- endcapture -%}

<div class="section-spacing section-spacing--tight color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}">
  <div class="container {% unless section.settings.container_size == 'full' %}container--{{ section.settings.container_size }}{% endunless %}">
    <product-rerender id="product-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" data-handle="{{ product.handle }}">
      <a href="/products/{{ product.handle }}" style="display:none;"></a>
      <div class="product">
        {%- if product.media.size > 0 -%}
          {%- render 'product-gallery',
              product: product,
              product_form_id: product_form_id,
              desktop_layout: section.settings.desktop_media_layout,
              mobile_controls: section.settings.mobile_controls,
              enable_media_autoplay: section.settings.enable_media_autoplay,
              enable_video_looping: section.settings.enable_video_looping,
              enable_image_zoom: section.settings.enable_image_zoom,
              max_image_zoom_level: section.settings.max_image_zoom_level,
              show_banner: section.settings.show_banner,
              banner_text: section.settings.banner_text,
              banner_position: section.settings.banner_position,
              banner_bg: section.settings.banner_bg,
              font_size_desktop: section.settings.font_size_desktop,
              font_size_mobile: section.settings.font_size_mobile,
              font_color: section.settings.font_color 
            -%}
        {%- endif -%}

        {%- render 'product-info', 
          product: product, 
          product_form_id: product_form_id,
          center_basic_info: section.settings.center_basic_info, 
          has_content_below_gallery: has_content_below_gallery, 
          context: 'main_product' 
        -%}

        {%- comment -%}On Prestige, some content may be on the left part below the product gallery{%- endcomment -%}
        {%- if has_content_below_gallery -%}
          <div id="product-extra-information" class="product-content-below-gallery empty:hidden scroll-margin-offset">
            {%- for block in section.blocks -%}
              {%- unless block.settings.show_below_gallery -%}
                {%- continue -%}
              {%- endunless -%}

              {%- case block.type -%}
                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    {%- if block.settings.collapse_content -%}
                      {%- assign accordion_title = 'product.general.description' | t -%}
                      {%- render 'accordion', title: accordion_title, content: product.description, prose_content: true, size: 'lg', block: block, open: block.settings.open -%}
                    {%- else -%}
                      <div class="product-content-below-gallery__description prose">
                        {{- product.description -}}
                      </div>
                    {%- endif -%}
                  {%- endif -%}

                {%- when 'accordion' -%}
                  {%- liquid
                    assign accordion_title = block.settings.page.title | default: block.settings.title 
                    assign accordion_content = block.settings.page.content | default: block.settings.liquid | default: block.settings.content

                    if accordion_title != blank and accordion_content != blank
                      render 'accordion', title: accordion_title, content: accordion_content, size: 'lg', prose_content: true, icon: block.settings.icon, custom_icon: block.settings.custom_icon, block: block, open: block.settings.open
                    endif
                  -%}

                {%- when 'complementary_products' -%}
                  {%- render 'complementary-products', product: product, block: block -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </product-rerender>
  </div>
</div>

{%- if section.settings.show_sticky_add_to_cart and product.available -%}
  <product-rerender id="{{ product_form_id }}-sticky-bar" observe-form="{{ product_form_id }}">
    <product-sticky-bar form="{{ product_form_id }}" class="product-sticky-bar">
      <div class="product-sticky-bar__info sm-max:hidden">
        <div class="h-stack gap-6">
          {%- if product.media.size > 0 -%}
            {%- assign default_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
            {{- default_media | image_url: width: default_media.width | image_tag: loading: 'lazy', sizes: '60px', widths: '60,120,180' -}}
          {%- endif -%}

          <div class="v-stack">
            <span class="h6">{{ product.title }}</span>

            {%- if product.selected_or_first_available_variant != nil -%}
              {%- render 'price-list', variant: product.selected_or_first_available_variant, hide_unit_price: true, context: 'card' -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      <buy-buttons class="buy-buttons" template="{{ product.template_suffix | escape }}" form="{{ product_form_id }}">
        {%- liquid
          assign button_disabled = false
          assign button_style = 'solid'

          if product.selected_or_first_available_variant == nil
            assign button_disabled = true
            assign button_style = 'outline'
            assign button_content = 'product.general.unavailable_button' | t
          elsif product.selected_or_first_available_variant.available == false
            assign button_disabled = true
            assign button_style = 'outline'
            assign button_content = 'product.general.sold_out_button' | t
          else
            if product.template_suffix contains 'pre-order'
              assign button_content = 'product.general.pre_order_button' | t
            else
              assign button_content = 'product.general.add_to_cart_button' | t
            endif
          endif
        -%}

        {%- render 'button', content: button_content, style: button_style, type: 'submit', form: product_form_id, disabled: button_disabled -%}
      </buy-buttons>
    </product-sticky-bar>
  </product-rerender>
{%- endif -%}

{%- comment -%}
IMPLEMENTATION NOTE: Shopify does not currently allows to render a given section within the context of a given product. However,
when rendering the quick buy drawers/popovers, we want to be able to re-use the merchant's choices (such as the selector type). This
is however only possible by rendering the whole product page, and extracting the relevant part. Here, we therefore render the
quick buy information in a template, that will be extracted in JS, which ensures it is not visible in the main product page
{%- endcomment -%}
{%- render 'product-quick-buy', product: product -%}

<script>
  // We save the product ID in local storage to be eventually used for recently viewed section
  try {
    let recentlyViewedProducts = JSON.parse(localStorage.getItem('theme:recently-viewed-products') || '[]');

    recentlyViewedProducts = recentlyViewedProducts.filter(item => item !== {{ product.id }}); // Delete product to remove to the start
    recentlyViewedProducts.unshift({{ product.id }}); // Add at the start

    localStorage.setItem('theme:recently-viewed-products', JSON.stringify(recentlyViewedProducts));
  } catch (e) {
    // Safari in private mode does not allow setting item, we silently fail
  }
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "class": "shopify-section--main-product",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_size",
      "label": "t:global.sizes.section_width",
      "options": [
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "xl",
          "label": "t:global.sizes.x_large"
        },
        {
          "value": "full",
          "label": "t:global.sizes.full_width"
        }
      ],
      "default": "lg"
    },
    {
      "type": "range",
      "id": "product_info_size",
      "label": "t:sections.main_product.product_info_size",
      "info": "t:sections.main_product.product_info_size_info",
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
