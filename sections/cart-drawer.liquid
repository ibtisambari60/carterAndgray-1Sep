  .bc-disc-pill { display: inline-flex; align-items: center; gap: 4px; background: #f1f1f1; color: #333; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .02em; padding: 4px 8px; border-radius: 0; }
