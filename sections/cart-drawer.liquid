  .bc-fbt__card { flex: 0 0 80%; scroll-snap-align: start; display: flex; gap: 12px; align-items: stretch; border: 1px solid #e5e5e5; border-radius: 0; padding: 10px; box-sizing: border-box; }
  .bc-fbt__thumb { flex: 0 0 84px; width: 84px; height: 108px; overflow: hidden; background: #f5f5f5; display: block; }
  .bc-fbt__thumb-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bc-fbt__body { display: flex; flex-direction: column; min-width: 0; flex: 1; }
