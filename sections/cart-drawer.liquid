  /* ---- Custom variant picker (native <dialog>, top-layer — avoids the position:fixed iOS scroll-freeze) ---- */
  .bc-picker { position: fixed; inset: 0; margin: 0; padding: 0; border: 0; width: 100vw; height: 100dvh; max-width: 100vw; max-height: 100dvh; background: transparent; overflow: visible; -webkit-tap-highlight-color: transparent; }
  .bc-picker[open] { display: flex; flex-direction: column; justify-content: flex-end; }
  .bc-picker::backdrop { background: rgba(0,0,0,.45); }
  .bc-picker button:focus, .bc-picker button:focus-visible { outline: none; box-shadow: none; }
  .bc-picker__panel { position: relative; width: 100%; max-height: 90dvh; overflow-y: auto; background: rgb(var(--background, 255 255 255)); padding: 18px 16px calc(30px + env(safe-area-inset-bottom)); box-shadow: 0 -6px 24px rgba(0,0,0,.15); }
  .bc-picker__close { position: absolute; top: 10px; right: 12px; border: 0; background: none; font-size: 26px; line-height: 1; cursor: pointer; color: #333; z-index: 2; }
  .bc-picker__back { display: inline-flex; align-items: center; gap: 5px; background: none; border: 0; padding: 0 0 12px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #555; cursor: pointer; }
  .bc-picker__back:hover { color: #111; }
  .bc-picker__head { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 14px; padding-right: 24px; }
  .bc-picker__img { flex: 0 0 66px; width: 66px; height: 82px; object-fit: cover; background: #f5f5f5; }
  .bc-picker__title { text-transform: uppercase; font-weight: 700; font-size: 13px; line-height: 1.25; margin: 0 0 4px; }
  .bc-picker__prices { display: flex; align-items: baseline; gap: 6px; }
  .bc-picker__was { color: #a2a2a2; font-size: 12.5px; text-decoration: line-through; }
  .bc-picker__now { font-weight: 700; font-size: 14px; }
  .bc-picker__now.is-sale { color: #e53935; }
  .bc-picker__optname { display: flex; justify-content: space-between; align-items: center; text-transform: uppercase; font-size: 11.5px; font-weight: 700; letter-spacing: .02em; color: #333; margin: 12px 0 7px; }
  .bc-picker__chart { font-size: 11px; font-weight: 600; text-decoration: underline; color: #6d6d6d; cursor: pointer; text-transform: none; letter-spacing: 0; }
  .bc-picker__vals { display: flex; flex-wrap: wrap; gap: 8px; }
  .bc-picker__val { min-width: 42px; padding: 9px 12px; border: 1px solid #d9d9d9; background: #fff; font-size: 13px; cursor: pointer; text-transform: uppercase; letter-spacing: .01em; }
  .bc-picker__val.is-selected { border-color: #111; background: #111; color: #fff; }
  .bc-picker__val.is-unavailable { color: #c4c4c4; border-color: #ececec; text-decoration: line-through; cursor: not-allowed; }
  .bc-picker__vals.is-swatches { gap: 10px; }
  .bc-picker__swatch { width: 68px; box-sizing: border-box; padding: 0 0 4px; border: 2px solid #e0e0e0; background: none; display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; }
  .bc-picker__swatch img { width: 100%; height: 78px; object-fit: cover; display: block; background: #f5f5f5; }
  .bc-picker__swatch.is-selected { border-color: #111; background: none; color: inherit; }
  .bc-picker__swatch-label { width: 100%; font-size: 9px; text-transform: uppercase; letter-spacing: .01em; color: #666; line-height: 1.15; text-align: center; word-break: break-word; }
  .bc-picker__swatch.is-unavailable { opacity: .4; text-decoration: none; }
  .bc-picker__swatch.is-unavailable .bc-picker__swatch-label { text-decoration: line-through; }
  .bc-picker__add { display: block; width: 100%; margin-top: 16px; border: 0; background: #111; color: #fff; text-transform: uppercase; font-weight: 700; letter-spacing: .03em; font-size: 14px; padding: 15px; cursor: pointer; }
  .bc-picker__add[disabled] { background: #bdbdbd; cursor: not-allowed; }


  /* ---- Size chart overlay ---- */

  .bc-reviews { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 12px; color: #4d4d4d; margin: 6px 0 0; }
  .bc-stars { --pct: 90%; display: inline-block; font-size: 14px; line-height: 1; letter-spacing: 1px; }
  .bc-stars::before { content: "\2605\2605\2605\2605\2605"; background: linear-gradient(90deg, #88795d var(--pct), #d9d3c6 var(--pct)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
