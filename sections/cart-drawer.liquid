{%- comment -%} ============================ STYLES ============================ {%- endcomment -%}
<style>
  /* Full-screen on mobile + tighter drawer padding */
  #cart-drawer { --drawer-body-padding-block: .55rem; --drawer-footer-padding-block: .4rem; }
  /* Mobile: full-screen drawer, solid white overlay panel, full dynamic-viewport height. */
  @media (max-width: 768px) {
    #cart-drawer { --drawer-max-width: 100vw; }
    #cart-drawer::part(overlay) { background: rgb(var(--background)); }
    #cart-drawer::part(base), #cart-drawer::part(content) { height: 100dvh; min-height: -webkit-fill-available; }
  }
  /* Remove header divider; keep panel white full height incl. safe area; divider above footer */
  #cart-drawer::part(header) { border-block-end: 0 !important; box-shadow: none !important; }
  #cart-drawer::part(base) { height: 100dvh; }
  #cart-drawer::part(content) { background: rgb(var(--background)); height: 100dvh; min-height: 100dvh; }
  #cart-drawer::part(footer) { background: rgb(var(--background)); border-block-start: 1px solid #ececec; padding-block-start: 0; padding-block-end: max(env(safe-area-inset-bottom), 4px); }

  .bc-cart .bc-cart__title { text-transform: uppercase; letter-spacing: .02em; }
  .bc-cart .bc-cart__count { color: #b6b6b6; font-weight: 500; margin-left: 4px; }

  /* ---- Empty state ---- */
  .bc-empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 8px 2px 4px; }
  .bc-empty__title { text-transform: uppercase; font-weight: 700; letter-spacing: .02em; font-size: 22px; margin: 8px 0 6px; }
  .bc-empty__sub { color: #7a7a7a; font-size: 14px; margin: 0 0 18px; white-space: nowrap; }
  .bc-empty__btn { display: inline-flex; align-items: center; justify-content: center; background: #111; color: #fff; text-transform: uppercase; font-weight: 700; letter-spacing: .04em; font-size: 14px; padding: 15px 44px; border-radius: 0; text-decoration: none; margin-bottom: 24px; }
  .bc-empty__btn:hover { background: #000; }
  .bc-empty__tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
  .bc-empty__tile { position: relative; display: block; border-radius: 0; overflow: hidden; aspect-ratio: 3 / 4; background: #f2f2f2; }
  .bc-empty__tile-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bc-empty__tile-label { position: absolute; left: 12px; bottom: 12px; color: #fff; text-transform: uppercase; font-weight: 700; letter-spacing: .04em; font-size: 15px; text-shadow: 0 1px 6px rgba(0,0,0,.35); }

  /* ---- Bundle deal bar ---- */
  .bc-rewards { padding: 4px 0 12px; }
  .bc-rewards__msg { font-size: 13px; margin: 0 0 8px; text-align: left; line-height: 1.3; }
  .bc-rewards__msg strong { font-weight: 700; }
  .bc-rewards__applied { font-weight: 400; }
  .bc-rewards__track { position: relative; height: 5px; border-radius: 100px; background: #ececec; overflow: visible; }
  .bc-rewards__fill { height: 100%; border-radius: 100px; transition: width .35s ease, background-color .35s ease; }
  .bc-rewards.is-locked .bc-rewards__fill { background: #e53935; }
  .bc-rewards.is-unlocked .bc-rewards__fill { background: #2e7d32; }
  .bc-rewards__tick { position: absolute; top: 50%; width: 2px; height: 8px; transform: translate(-50%, -50%); background: #fff; opacity: .9; }

  /* ---- Custom line items (Icon-style, heights synced to photo) ---- */
  .bc-items { margin-top: 2px; }
  .bc-li { display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid #f0f0f0; }
  .bc-li__thumb { flex: 0 0 92px; width: 92px; height: 112px; overflow: hidden; background: #f5f5f5; display: block; }
  .bc-li__thumb-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bc-li__info { flex: 1; min-width: 0; min-height: 112px; display: flex; flex-direction: column; gap: 4px; }
