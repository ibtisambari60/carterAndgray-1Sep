{%- comment -%} Header item count + cart gender (excludes shipping protection) {%- endcomment -%}
{%- assign header_count = 0 -%}
{%- assign cart_gender = '' -%}
{%- for item in cart.items -%}
  {%- unless item.product.handle == 'shipping-protection' -%}
    {%- assign header_count = header_count | plus: item.quantity -%}
    {%- if cart_gender == '' -%}
      {%- assign it = item.product.title | downcase -%}
      {%- if it contains 'women' -%}{%- assign cart_gender = 'women' -%}
      {%- elsif it contains 'men' -%}{%- assign cart_gender = 'men' -%}{%- endif -%}
    {%- endif -%}
  {%- endunless -%}
{%- endfor -%}

<cart-drawer id="cart-drawer" class="cart-drawer drawer bc-cart {% if cart.empty? %}drawer--center-body{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }}" data-show-sp="{{ section.settings.show_shipping_protection }}" data-show-bundle="{{ section.settings.show_bundle_bar }}" data-show-fbt="{{ section.settings.show_fbt }}" data-fbt-title="{{ section.settings.fbt_title | default: 'People also bought' | escape }}" data-fbt-btn="{{ section.settings.fbt_button_text | default: 'Add +' | escape }}" data-show-checkout="{{ section.settings.show_checkout_button }}" data-show-pay="{{ section.settings.show_payment_icons }}" data-show-reviews="{{ section.settings.show_reviews }}" data-empty1="{% if section.settings.empty_image_1 != blank %}{{ section.settings.empty_image_1 | image_url: width: 700 }}{% else %}https://cdn.shopify.com/s/files/1/1005/2209/9036/files/Women_collection_-_B_C.png?v=1783199471&width=700{% endif %}" data-empty2="{% if section.settings.empty_image_2 != blank %}{{ section.settings.empty_image_2 | image_url: width: 700 }}{% else %}https://cdn.shopify.com/s/files/1/1005/2209/9036/files/Men_collection_-B_C.png?v=1783199447&width=700{% endif %}" initial-focus="false" handle-editor-events>
  <p class="h4 bc-cart__title" slot="header">{{ 'cart.general.title' | t }}{%- if header_count > 0 %} <span class="bc-cart__count">{{ header_count }}</span>{% endif -%}</p>

  {%- if cart.empty? -%}
    {%- comment -%} ---------------- EMPTY STATE (Icon-style, B&C house style) ---------------- {%- endcomment -%}
    {%- assign c1 = section.settings.empty_collection_1 -%}
    {%- unless c1 != blank -%}{%- assign c1 = collections['women'] -%}{%- endunless -%}
    {%- assign c2 = section.settings.empty_collection_2 -%}
    {%- unless c2 != blank -%}{%- assign c2 = collections['men'] -%}{%- endunless -%}

    <div class="bc-empty">
      <p class="bc-empty__title">{{ section.settings.empty_title | default: 'Your cart is empty' }}</p>
      <p class="bc-empty__sub">{{ section.settings.empty_subtitle | default: 'Discover our latest collections' }}</p>
      <a href="{{ section.settings.empty_button_link | default: '/collections/all-products' }}" class="bc-empty__btn">{{ section.settings.empty_button_text | default: 'Shop all' }}</a>

      <div class="bc-empty__tiles">
        {%- if section.settings.empty_image_1 != blank -%}{%- assign tile1_src = section.settings.empty_image_1 | image_url: width: 700 -%}{%- else -%}{%- assign tile1_src = 'https://cdn.shopify.com/s/files/1/1005/2209/9036/files/Women_collection_-_B_C.png?v=1783199471&width=700' -%}{%- endif -%}
        {%- if section.settings.empty_image_2 != blank -%}{%- assign tile2_src = section.settings.empty_image_2 | image_url: width: 700 -%}{%- else -%}{%- assign tile2_src = 'https://cdn.shopify.com/s/files/1/1005/2209/9036/files/Men_collection_-B_C.png?v=1783199447&width=700' -%}{%- endif -%}
        <a href="{{ c1.url | default: '/collections/women' }}" class="bc-empty__tile">
          <img src="{{ tile1_src }}" alt="{{ section.settings.empty_label_1 | default: 'Women' }}" loading="lazy" width="600" height="800" class="bc-empty__tile-img">
          <span class="bc-empty__tile-label">{{ section.settings.empty_label_1 | default: 'Women' }}</span>
        </a>
        <a href="{{ c2.url | default: '/collections/men' }}" class="bc-empty__tile">
          <img src="{{ tile2_src }}" alt="{{ section.settings.empty_label_2 | default: 'Men' }}" loading="lazy" width="600" height="800" class="bc-empty__tile-img">
          <span class="bc-empty__tile-label">{{ section.settings.empty_label_2 | default: 'Men' }}</span>
        </a>
      </div>
    </div>

  {%- else -%}
    {%- comment -%} ---------------- BUNDLE DEAL BAR (tiered, editable in theme editor) ---------------- {%- endcomment -%}
    {%- if section.settings.show_bundle_bar -%}
    {%- assign bp2 = section.settings.bundle_pct_2 | default: 10 -%}
    {%- assign bp3 = section.settings.bundle_pct_3 | default: 15 -%}
    {%- assign bp4 = section.settings.bundle_pct_4 | default: 20 -%}
    {%- assign bp5 = section.settings.bundle_pct_5 | default: 25 -%}
    {%- assign bundle_qty = header_count -%}
    {%- assign cur_disc = 0 -%}
    {%- if bundle_qty >= 2 -%}{%- assign cur_disc = bp2 -%}{%- endif -%}
    {%- if bundle_qty >= 3 -%}{%- assign cur_disc = bp3 -%}{%- endif -%}
    {%- if bundle_qty >= 4 -%}{%- assign cur_disc = bp4 -%}{%- endif -%}
    {%- if bundle_qty >= 5 -%}{%- assign cur_disc = bp5 -%}{%- endif -%}
    {%- assign next_thresh = 0 -%}
    {%- assign next_disc = 0 -%}
    {%- if bundle_qty < 2 -%}
      {%- assign next_thresh = 2 -%}{%- assign next_disc = bp2 -%}
    {%- elsif bundle_qty < 3 -%}
      {%- assign next_thresh = 3 -%}{%- assign next_disc = bp3 -%}
    {%- elsif bundle_qty < 4 -%}
      {%- assign next_thresh = 4 -%}{%- assign next_disc = bp4 -%}
    {%- elsif bundle_qty < 5 -%}
      {%- assign next_thresh = 5 -%}{%- assign next_disc = bp5 -%}
    {%- endif -%}
    {%- assign remaining = next_thresh | minus: bundle_qty -%}
    {%- assign fill_pct = bundle_qty | times: 20 -%}
    {%- if fill_pct > 100 -%}{%- assign fill_pct = 100 -%}{%- endif -%}
    {%- if bundle_qty >= 2 -%}{%- assign bar_state = 'is-unlocked' -%}{%- else -%}{%- assign bar_state = 'is-locked' -%}{%- endif -%}

    <div class="bc-rewards {{ bar_state }}">
      <p class="bc-rewards__msg">
        {%- if bundle_qty >= 5 -%}
          <strong>{{ bp5 }}% off</strong> automatically applied!
        {%- elsif bundle_qty < 2 -%}
          Add <strong>{{ remaining }} more item{% if remaining != 1 %}s{% endif %}</strong> to save an extra <strong>{{ next_disc }}% off</strong>
        {%- else -%}
          Add <strong>{{ remaining }} more item{% if remaining != 1 %}s{% endif %}</strong> for <strong>{{ next_disc }}% off</strong> <span class="bc-rewards__applied">| {{ cur_disc }}% off applied!</span>
        {%- endif -%}
      </p>
      <div class="bc-rewards__track">
        <div class="bc-rewards__fill" style="width: {{ fill_pct }}%;"></div>
        {%- for t in (2..5) -%}
          {%- assign tick_pos = t | times: 20 -%}
          <span class="bc-rewards__tick {% if bundle_qty >= t %}is-passed{% endif %}" style="left: {{ tick_pos }}%;"></span>
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    {%- comment -%} ---------------- LINE ITEMS (custom, double strike-through) ---------------- {%- endcomment -%}
    <div class="cart-drawer__items bc-items">
      {%- for line_item in cart.items -%}
        {%- if line_item.product.handle == 'shipping-protection' -%}{%- continue -%}{%- endif -%}
        {%- assign v = line_item.variant -%}
        <div class="bc-li">
          <a href="{{ line_item.url }}" class="bc-li__thumb" data-instant>
            {%- if line_item.image -%}
              {{ line_item.image | image_url: width: 200 | image_tag: loading: 'lazy', sizes: '84px', widths: '84,120,168,240', class: 'bc-li__thumb-img' }}
            {%- endif -%}
          </a>
          <div class="bc-li__info">
            <a href="{{ line_item.url }}" class="bc-li__name" data-instant>{{ line_item.product.title | default: line_item.title }}</a>

            <div class="bc-li__prices">
              {%- if v.compare_at_price and v.compare_at_price > line_item.original_price -%}
                <s class="bc-li__was">{{ v.compare_at_price | money }}</s>
              {%- endif -%}
              {%- if line_item.original_price > line_item.final_price -%}
                <s class="bc-li__was">{{ line_item.original_price | money }}</s>
                <span class="bc-li__now is-sale">{{ line_item.final_price | money }}</span>
              {%- elsif v.compare_at_price and v.compare_at_price > line_item.original_price -%}
                <span class="bc-li__now is-sale">{{ line_item.final_price | money }}</span>
              {%- else -%}
                <span class="bc-li__now">{{ line_item.final_price | money }}</span>
              {%- endif -%}
            </div>

            {%- unless line_item.product.has_only_default_variant or line_item.gift_card -%}
              <p class="bc-li__variant">{{ line_item.variant.title }}</p>
            {%- endunless -%}

            <div class="bc-li__qtyrow">
              <div class="bc-li__qty" data-key="{{ line_item.key }}">
                <button type="button" class="bc-li__qtybtn" data-delta="-1" aria-label="Decrease quantity">&minus;</button>
                <span class="bc-li__qtyval">{{ line_item.quantity }}</span>
                <button type="button" class="bc-li__qtybtn" data-delta="1" aria-label="Increase quantity">+</button>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} ---------------- FBT UPSELL (same-gender, data-driven, max 4) ---------------- {%- endcomment -%}
    {%- assign fbt_max = 4 -%}
    {%- assign cart_handles = ',' -%}
    {%- for item in cart.items -%}
      {%- assign cart_handles = cart_handles | append: item.product.handle | append: ',' -%}
    {%- endfor -%}

    {%- assign fbt_handles = '' -%}
    {%- assign fbt_n = 0 -%}

    {%- comment -%} tier 1: real co-purchase from custom.fbt {%- endcomment -%}
    {%- for item in cart.items -%}
      {%- assign recs = item.product.metafields.custom.fbt.value -%}
      {%- if recs -%}
        {%- for p in recs -%}
          {%- if fbt_n >= fbt_max -%}{%- break -%}{%- endif -%}
          {%- assign hh = ',' | append: p.handle | append: ',' -%}
          {%- assign pt = p.title | downcase -%}
          {%- assign pg = 'uni' -%}
          {%- if pt contains 'women' -%}{%- assign pg = 'women' -%}{%- elsif pt contains 'men' -%}{%- assign pg = 'men' -%}{%- endif -%}
          {%- assign gok = true -%}
          {%- if cart_gender != '' and pg != 'uni' and pg != cart_gender -%}{%- assign gok = false -%}{%- endif -%}
          {%- unless cart_handles contains hh or fbt_handles contains hh or p.handle == 'shipping-protection' or p.available == false or gok == false -%}
            {%- assign fbt_handles = fbt_handles | append: hh -%}
            {%- assign fbt_n = fbt_n | plus: 1 -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} detect cart category (footwear vs apparel) for complementary logic {%- endcomment -%}
    {%- assign cart_cat = 'apparel' -%}
    {%- for item in cart.items -%}
      {%- assign ct = item.product.title | downcase -%}
      {%- if ct contains 'clog' or ct contains 'sandal' or ct contains 'loafer' or ct contains 'shoe' or ct contains 'boot' or ct contains 'trainer' or ct contains 'mule' or ct contains 'brogue' or ct contains 'heel' or ct contains 'wedge' -%}
        {%- assign cart_cat = 'footwear' -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} tier 2: same-gender COMPLEMENTARY category (outfit completion when no co-purchase data) {%- endcomment -%}
    {%- if fbt_n < fbt_max -%}
      {%- if cart_gender == 'women' and cart_cat == 'footwear' -%}
        {%- assign complementary = 'women-s-summer-printed-shirt-dress-maxi,women-s-blouse-v-neck-short-sleeve,women-s-cardigan-v-neck-with-buttons,women-s-shirt-button-up-long-sleeve,women-s-high-waist-knee-length-shorts-loose-fit' | split: ',' -%}
      {%- elsif cart_gender == 'women' -%}
        {%- assign complementary = 'women-s-high-waist-knee-length-shorts-loose-fit,womens-sandals-with-adjustable-straps,women-s-cardigan-v-neck-with-buttons,womens-loafers-with-cushioned-insole,women-s-tote-bag-large-with-inner-pockets' | split: ',' -%}
      {%- elsif cart_cat == 'footwear' -%}
        {%- assign complementary = 'men-s-jeans-loose-fit-straight-leg,men-s-shirt-linen-look-long-sleeve,men-s-shirt-wrinkle-free-slim-fit,men-s-harrington-jacket-lightweight-zip-up-with-collar,men-s-cargo-shorts-with-utility-pockets' | split: ',' -%}
      {%- else -%}
        {%- assign complementary = 'men-s-jeans-loose-fit-straight-leg,mens-clogs-comfort-slip-on-beige,men-s-cardigan-button-v-neck,men-s-loafers-suede-look-with-lace-up-detail,men-s-cargo-shorts-with-utility-pockets' | split: ',' -%}
      {%- endif -%}
      {%- for h in complementary -%}
        {%- if fbt_n >= fbt_max -%}{%- break -%}{%- endif -%}
        {%- assign hh = ',' | append: h | append: ',' -%}
        {%- assign fp = all_products[h] -%}
        {%- unless cart_handles contains hh or fbt_handles contains hh or fp == empty or fp.available == false -%}
          {%- assign fbt_handles = fbt_handles | append: hh -%}
          {%- assign fbt_n = fbt_n | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} tier 3: same-gender bestsellers (any category) — final safety net {%- endcomment -%}
    {%- if fbt_n < fbt_max -%}
      {%- if cart_gender == 'women' -%}
        {%- assign hard_fallback = 'womens-loafers-with-cushioned-insole,women-s-mules-breathable-mesh-with-air-cushion,women-s-summer-printed-shirt-dress-maxi,women-s-blouse-v-neck-short-sleeve,women-s-clogs-suede-look-with-buckle-strap' | split: ',' -%}
      {%- else -%}
        {%- assign hard_fallback = 'men-s-loafers-suede-look-with-lace-up-detail,men-s-sandals-double-buckle-with-contoured-footbed,men-s-jeans-loose-fit-straight-leg,mens-shoes-comfort-with-cushioned-insole,men-s-harrington-jacket-lightweight-zip-up-with-collar' | split: ',' -%}
      {%- endif -%}
      {%- for h in hard_fallback -%}
        {%- if fbt_n >= fbt_max -%}{%- break -%}{%- endif -%}
        {%- assign hh = ',' | append: h | append: ',' -%}
        {%- assign fp = all_products[h] -%}
        {%- unless cart_handles contains hh or fbt_handles contains hh or fp == empty or fp.available == false -%}
          {%- assign fbt_handles = fbt_handles | append: hh -%}
          {%- assign fbt_n = fbt_n | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} tier 4: merchant-picked fallback products (theme setting) — store-agnostic, needs no metafields, orders or API. On a store without co-purchase data this is what fills the upsell. {%- endcomment -%}
    {%- if fbt_n < fbt_max and section.settings.fbt_fallback_products != blank -%}
      {%- for fp in section.settings.fbt_fallback_products -%}
        {%- if fbt_n >= fbt_max -%}{%- break -%}{%- endif -%}
        {%- assign hh = ',' | append: fp.handle | append: ',' -%}
        {%- unless cart_handles contains hh or fbt_handles contains hh or fp == empty or fp.available == false or fp.handle == 'shipping-protection' -%}
          {%- assign fbt_handles = fbt_handles | append: hh -%}
          {%- assign fbt_n = fbt_n | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if section.settings.show_fbt and fbt_n > 0 -%}
      <div class="bc-fbt">
        <p class="bc-fbt__title">{{ section.settings.fbt_title | default: 'People also bought' }}</p>
        <div class="bc-fbt__scroller">
          {%- assign fbt_list = fbt_handles | split: ',' -%}
          {%- for h in fbt_list -%}
            {%- if h == blank -%}{%- continue -%}{%- endif -%}
            {%- assign fp = all_products[h] -%}
            {%- if fp == empty or fp.available == false -%}{%- continue -%}{%- endif -%}
            {%- assign fv = fp.selected_or_first_available_variant -%}
            <div class="bc-fbt__card">
              <a href="{{ fp.url }}" class="bc-fbt__thumb" data-instant>
                {%- if fp.featured_media -%}
                  {{ fp.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', sizes: '90px', widths: '90,140,180,220', class: 'bc-fbt__thumb-img' }}
                {%- endif -%}
              </a>
              <div class="bc-fbt__body">
                <a href="{{ fp.url }}" class="bc-fbt__name" data-instant>{{ fp.title }}</a>
                <div class="bc-fbt__prices">
                  {%- if fv.compare_at_price > fv.price -%}
                    <s class="bc-fbt__was">{{ fv.compare_at_price | money }}</s>
                    <span class="bc-fbt__now is-sale">{{ fv.price | money }}</span>
                  {%- else -%}
                    <span class="bc-fbt__now">{{ fv.price | money }}</span>
                  {%- endif -%}
                </div>
                {%- if fp.variants.size == 1 -%}
                  <product-form class="bc-fbt__form">
                    {%- form 'product', fp -%}
                      <input type="hidden" name="id" value="{{ fv.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <input type="hidden" name="on_success" value="force_open_drawer">
                      <button type="submit" class="bc-fbt__add">{{ section.settings.fbt_button_text | default: 'Add +' }}</button>
                    {%- endform -%}
                  </product-form>
                {%- else -%}
                  {%- comment -%} Multi-variant: open the custom in-drawer colour/size picker {%- endcomment -%}
                  <div class="bc-fbt__form">
                    <button type="button" class="bc-fbt__add" data-bc-picker data-handle="{{ fp.handle }}" data-url="{{ fp.url }}">{{ section.settings.fbt_button_text | default: 'Add +' }}</button>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ---------------- FOOTER (compact) ---------------- {%- endcomment -%}
    <form action="{{ routes.cart_url }}" method="POST" class="bc-footer" slot="footer">

      {%- assign sp_variant = section.settings.shipping_protection_variant -%}
      {%- if section.settings.show_shipping_protection and sp_variant != blank -%}
        {%- assign sp_in_cart = false -%}
        {%- for item in cart.items -%}
          {%- assign vid = item.variant_id | append: '' -%}
          {%- if vid == sp_variant -%}{%- assign sp_in_cart = true -%}{%- endif -%}
        {%- endfor -%}
        <div class="bc-protection {% if sp_in_cart %}is-on{% endif %}">
          <div class="bc-protection__text">
            <span class="bc-protection__title">{{ section.settings.protection_title | default: '100% Shipping Protection' }}</span>
            <span class="bc-protection__sub">{{ section.settings.protection_sub | default: 'Don&rsquo;t take any risks' }}</span>
          </div>
          <span class="bc-protection__price">{{ section.settings.protection_price | default: '&pound;2.95' }}</span>
          <button type="button" class="bc-toggle {% if sp_in_cart %}is-on{% endif %}" data-variant="{{ sp_variant }}" aria-pressed="{% if sp_in_cart %}true{% else %}false{% endif %}" aria-label="Toggle shipping protection">
            <span class="bc-toggle__knob"></span>
          </button>
        </div>
      {%- endif -%}

      {%- assign disc_total = cart.original_total_price | minus: cart.total_price -%}
      {%- comment -%} compare-at total for double strike-through (product sale + bundle) {%- endcomment -%}
      {%- assign compare_total = 0 -%}
      {%- for item in cart.items -%}
        {%- if item.variant.compare_at_price and item.variant.compare_at_price > item.original_price -%}
          {%- assign line_c = item.variant.compare_at_price | times: item.quantity -%}
        {%- else -%}
          {%- assign line_c = item.original_price | times: item.quantity -%}
        {%- endif -%}
        {%- assign compare_total = compare_total | plus: line_c -%}
      {%- endfor -%}
      {%- assign total_saved = compare_total | minus: cart.total_price -%}
      {%- if section.settings.free_delivery_text != blank -%}
        <div class="bc-row bc-row--free"><span class="bc-free-delivery">{{ section.settings.free_delivery_text }}</span></div>
      {%- endif -%}

      {%- if disc_total > 0 -%}
        {%- assign disc_title = '' -%}
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          {%- assign disc_title = cart.cart_level_discount_applications.first.title -%}
        {%- elsif cart.discount_applications.size > 0 -%}
          {%- assign disc_title = cart.discount_applications.first.title -%}
        {%- endif -%}
        <div class="bc-row bc-row--disc">
          <span class="bc-disc-label">Discounts</span>
          {%- if disc_title != blank -%}<span class="bc-disc-pill">{%- render 'icon' with 'discount', width: 12 -%} {{ disc_title }}</span>{%- endif -%}
          <span class="bc-disc-amt">-{{ disc_total | money }}</span>
        </div>
      {%- endif -%}

      <div class="bc-row bc-row--subtotal">
        <span class="bc-subtotal__label">Subtotal</span>
        <span class="bc-subtotal__vals">
          {%- if compare_total > cart.original_total_price -%}<s class="bc-subtotal__was">{{ compare_total | money }}</s>{%- endif -%}
          {%- if cart.original_total_price > cart.total_price -%}<s class="bc-subtotal__was">{{ cart.original_total_price | money }}</s>{%- endif -%}
          <strong class="bc-subtotal__now">{{ cart.total_price | money }}</strong>
          {%- if total_saved > 0 -%}<span class="bc-save">Save {{ total_saved | money }}</span>{%- endif -%}
        </span>
      </div>

      {%- if section.settings.show_checkout_button -%}
        <button type="submit" name="checkout" class="bc-checkout">
          <svg class="bc-checkout__lock" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5zm-3 5a3 3 0 0 1 6 0v3H9V7zm3 7a1.5 1.5 0 0 1 .75 2.8V19a.75.75 0 0 1-1.5 0v-2.2A1.5 1.5 0 0 1 12 14z"/>
          </svg>
          <span>{{ section.settings.checkout_text | default: 'Checkout Securely' }}</span>
        </button>
      {%- endif -%}

      {%- if section.settings.show_payment_icons -%}
        {%- comment -%} Same custom payment icons as the product page (uploaded to Files) {%- endcomment -%}
        <ul class="payment-methods unstyled-list bc-payments">
          <li><img src="https://cdn.shopify.com/s/files/1/1005/2209/9036/files/amex-svgrepo-com_2.svg?v=1772398597" alt="American Express" loading="lazy" width="38" height="24"></li>
          <li><img src="https://cdn.shopify.com/s/files/1/1005/2209/9036/files/apple-pay-svgrepo-com_1.svg?v=1772398597" alt="Apple Pay" loading="lazy" width="38" height="24"></li>
          <li><img src="https://cdn.shopify.com/s/files/1/1005/2209/9036/files/google-pay-svgrepo-com_2.svg?v=1772398597" alt="Google Pay" loading="lazy" width="38" height="24"></li>
          <li><img src="https://cdn.shopify.com/s/files/1/1005/2209/9036/files/mastercard-svgrepo-com_2.svg?v=1772398597" alt="Mastercard" loading="lazy" width="38" height="24"></li>
          <li><img src="https://cdn.shopify.com/s/files/1/1005/2209/9036/files/Shop-pay-logo.avif?v=1778019426" alt="Shop Pay" loading="lazy" width="38" height="24"></li>
          <li><img src="https://cdn.shopify.com/s/files/1/1005/2209/9036/files/visa-svgrepo-com_2.svg?v=1772398597" alt="Visa" loading="lazy" width="38" height="24"></li>
        </ul>
      {%- endif -%}

      {%- if section.settings.show_reviews and section.settings.reviews_text != blank -%}
        <div class="bc-reviews">
          <span class="bc-stars" style="--pct: {{ section.settings.reviews_rating | default: 4.5 | times: 20 }}%;" aria-hidden="true"></span>
          <span class="bc-reviews__txt">{{ section.settings.reviews_text }}</span>
        </div>
      {%- endif -%}
    </form>

  {%- endif -%}
</cart-drawer>

