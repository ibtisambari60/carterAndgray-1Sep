  .bc-fbt__form { margin-top: auto; }
  .bc-fbt__add { display: block; box-sizing: border-box; width: 100%; text-align: center; text-decoration: none; border: 0; background: #111; color: #fff; text-transform: uppercase; font-weight: 700; letter-spacing: .04em; font-size: 12px; padding: 11px 10px; border-radius: 0; cursor: pointer; }
  .bc-fbt__add:hover { background: #000; }

  /* ---- Footer (compact, compartment rows) ---- */
  .bc-footer { display: flex; flex-direction: column; align-items: stretch; gap: 0; background: rgb(var(--background, 255 255 255)); }
  .bc-footer > * { width: 100%; box-sizing: border-box; }
  /* The footer part already draws a top divider. Whatever ends up first inside it (the protection row, or
     the free-delivery row when protection is hidden) must not add its own top border, otherwise you get a
     double grey line. */
  .bc-footer > *:first-child { border-top: none; }
  .bc-protection { display: flex; align-items: center; gap: 12px; background: #f4f4f4; border-radius: 0; padding: 8px 12px; margin: 6px 0; }
  .bc-protection__text { display: flex; flex-direction: column; line-height: 1.25; margin-right: auto; }
  .bc-protection__title { text-transform: uppercase; font-weight: 700; font-size: 11.5px; letter-spacing: .01em; }
