    { "type": "color_scheme", "id": "color_scheme", "label": "t:global.colors.scheme", "default": "scheme-1" },

    { "type": "header", "content": "Bundle deal bar" },
    { "type": "checkbox", "id": "show_bundle_bar", "label": "Show bundle deal bar", "default": true },
    { "type": "paragraph", "content": "These percentages are only what the bar DISPLAYS. Make sure they match your actual automatic discounts under Shopify > Discounts." },
    { "type": "range", "id": "bundle_pct_2", "label": "2 items – % off", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 10 },
    { "type": "range", "id": "bundle_pct_3", "label": "3 items – % off", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 15 },
    { "type": "range", "id": "bundle_pct_4", "label": "4 items – % off", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 20 },
    { "type": "range", "id": "bundle_pct_5", "label": "5 items – % off", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 25 },

