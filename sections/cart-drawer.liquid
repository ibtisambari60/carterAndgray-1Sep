  .bc-fbt__scroller { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
  .bc-fbt__scroller::-webkit-scrollbar { height: 4px; }
