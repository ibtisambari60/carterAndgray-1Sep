{%- comment -%} ============================ SCRIPT ============================ {%- endcomment -%}
<script>
  (function () {
    if (window.__bcCartInit) return;
    window.__bcCartInit = true;

    /* Enforce THIS page's settings after any drawer re-render. The section-render endpoint always returns
       the PUBLISHED theme, which can differ from what this page shows (theme preview, editor, or a cache
       window right after a settings change). Without this, turning a block OFF (bundle bar, reviews, upsell,
       payment icons, checkout, shipping protection) or changing the empty-cart images would "fall back" to
       the published version on the next cart refresh. We read the real settings off the persistent
       <cart-drawer> element (rendered by this page) and re-apply them. On a consistent theme it's a no-op. */
    function bcEnforceSettings(root) {
      if (!root) return;
      var off = function (a) { return root.getAttribute(a) === 'false'; };
      var drop = function (sel) { var el = root.querySelector(sel); if (el && el.parentNode) { el.parentNode.removeChild(el); } };
      if (off('data-show-sp'))       drop('.bc-protection');
      if (off('data-show-bundle'))   drop('.bc-rewards');
      if (off('data-show-fbt'))      drop('.bc-fbt');
      if (off('data-show-checkout')) drop('.bc-checkout');
      if (off('data-show-pay'))      drop('.bc-payments');
      if (off('data-show-reviews'))  drop('.bc-reviews');
      var e1 = root.getAttribute('data-empty1'), e2 = root.getAttribute('data-empty2');
      var tiles = root.querySelectorAll('.bc-empty__tile-img');
      if (e1 && tiles[0] && tiles[0].getAttribute('src') !== e1) { tiles[0].setAttribute('src', e1); }
      if (e2 && tiles[1] && tiles[1].getAttribute('src') !== e2) { tiles[1].setAttribute('src', e2); }
    }

    /* ---- Automatic upsell via Shopify's built-in Product Recommendations engine ----
       Store-agnostic: needs no metafields, no app and no API connection. It activates only when the Liquid
       tiers produced no "People also bought" block (typically a store that has no co-purchase data yet). It
       asks Shopify for products related to what's in the cart, filters them to the cart's gender, and
       renders them. It gets better on its own as the store gathers orders. On a store that already has real
       data (like B&C) the Liquid block exists, so this stays dormant. */
    function bcEsc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
    function bcGender(t){ t=(t||'').toLowerCase(); if(t.indexOf('women')>-1||t.indexOf('ladies')>-1) return 'women'; if(t.indexOf('men')>-1) return 'men'; return 'uni'; }
    /* Coarse category so we can push COMPLEMENTARY items (a different category than what's in the cart) to
       the front, instead of "more of the same". footwear vs accessory vs apparel. */
    function bcCat(t){ t=(t||'').toLowerCase();
      if(/clog|sandal|loafer|\bshoe|boot|trainer|sneaker|\bmule|brogue|\bheel|wedge|slipper|footwear|flip.?flop|espadrille/.test(t)) return 'footwear';
      if(/\bbag|tote|backpack|purse|\bbelt|\bhat\b|\bcap\b|scarf|sunglass|watch|jewel|\bsock|wallet|glove|beanie|necklace|bracelet/.test(t)) return 'accessory';
      return 'apparel';
    }
    function bcFmt(cents,cur){ try{ return new Intl.NumberFormat(undefined,{style:'currency',currency:cur||'GBP'}).format((cents||0)/100); }catch(e){ return '£'+((cents||0)/100).toFixed(2); } }
    function bcRenderUpsell(dr, items, picks, currency){
      if (dr.querySelector('.bc-fbt')) return;
      var title = dr.getAttribute('data-fbt-title') || 'People also bought';
      var btn = dr.getAttribute('data-fbt-btn') || 'Add +';
      var html = '<p class="bc-fbt__title">'+bcEsc(title)+'</p><div class="bc-fbt__scroller">';
      picks.forEach(function(p){
        var url = (p.url || ('/products/'+p.handle)).split('?')[0];
        var img = p.featured_image || '';
        if (img.indexOf('//')===0) { img='https:'+img; }
        if (img) { img += (img.indexOf('?')>-1?'&':'?')+'width=200'; }
        var price = (p.compare_at_price && p.compare_at_price>p.price)
          ? '<s class="bc-fbt__was">'+bcFmt(p.compare_at_price,currency)+'</s><span class="bc-fbt__now is-sale">'+bcFmt(p.price,currency)+'</span>'
          : '<span class="bc-fbt__now">'+bcFmt(p.price,currency)+'</span>';
        var add = (p.variants && p.variants.length===1)
          ? '<button type="button" class="bc-fbt__add" data-fbt-add="'+p.variants[0].id+'">'+bcEsc(btn)+'</button>'
          : '<button type="button" class="bc-fbt__add" data-bc-picker data-handle="'+bcEsc(p.handle)+'" data-url="'+bcEsc(url)+'">'+bcEsc(btn)+'</button>';
        html += '<div class="bc-fbt__card"><a href="'+bcEsc(url)+'" class="bc-fbt__thumb" data-instant>'+(img?'<img src="'+bcEsc(img)+'" class="bc-fbt__thumb-img" loading="lazy" width="90" height="108">':'')+'</a>'+
                '<div class="bc-fbt__body"><a href="'+bcEsc(url)+'" class="bc-fbt__name" data-instant>'+bcEsc(p.title)+'</a>'+
                '<div class="bc-fbt__prices">'+price+'</div><div class="bc-fbt__form">'+add+'</div></div></div>';
      });
      html += '</div>';
      var wrap = document.createElement('div'); wrap.className = 'bc-fbt'; wrap.innerHTML = html;
      items.insertAdjacentElement('afterend', wrap);
    }
    var bcUpsellBusy = false;
    function bcMaybeAutoUpsell(){
      var dr = document.getElementById('cart-drawer'); if(!dr) return;
      if (dr.getAttribute('data-show-fbt') === 'false') return;      /* upsell disabled */
      if (dr.querySelector('.bc-fbt')) return;                        /* a block already exists (Liquid or ours) */
      var items = dr.querySelector('.bc-items');
      if (!items || !items.querySelector('.bc-li')) return;           /* empty cart, nothing to base it on */
      if (bcUpsellBusy) return; bcUpsellBusy = true;
      fetch('/cart.js', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function(r){ return r.json(); }).then(function(cart){
        if (!cart.items || !cart.items.length) return;
        var cartHandles = {}, dom = 'uni', catCount = {};
        cart.items.forEach(function(it){
          cartHandles[it.handle]=1;
          var g=bcGender(it.product_title||it.title); if(dom==='uni'&&g!=='uni'){ dom=g; }
          var c=bcCat((it.product_type||'')+' '+(it.product_title||it.title)); catCount[c]=(catCount[c]||0)+1;
        });
        var catDom='', catMax=0; Object.keys(catCount).forEach(function(k){ if(catCount[k]>catMax){ catMax=catCount[k]; catDom=k; } });
        var ids = []; cart.items.slice(0,3).forEach(function(it){ if(ids.indexOf(it.product_id)<0){ ids.push(it.product_id); } });
        return Promise.all(ids.map(function(id){
          return fetch('/recommendations/products.json?product_id='+id+'&intent=related&limit=10').then(function(r){ return r.json(); }).catch(function(){ return { products: [] }; });
        })).then(function(results){
          var seen = {}, comp = [], same = [];
          results.forEach(function(res){ (res.products||[]).forEach(function(p){
            if (cartHandles[p.handle] || seen[p.handle]) return;
            if (p.handle==='shipping-protection' || p.available===false) return;
            var g = bcGender(p.title);
            if (dom!=='uni' && g!=='uni' && g!==dom) return;           /* gender filter */
            seen[p.handle]=1;
            /* complementary (different category than the cart) goes first, "more of the same" last */
            if (catDom && bcCat((p.type||'')+' '+p.title) === catDom) { same.push(p); } else { comp.push(p); }
          }); });
          var picks = comp.concat(same).slice(0,4);
          if (picks.length && !dr.querySelector('.bc-fbt')) { bcRenderUpsell(dr, items, picks, cart.currency); }
        });
      }).then(function(){ bcUpsellBusy=false; }, function(){ bcUpsellBusy=false; });
    }

    /* Single-variant auto-upsell "Add +" adds straight to the cart. (Multi-variant buttons reuse the shared
       data-bc-picker colour/size handler.) */
    document.addEventListener('click', function(e){
      var b = e.target.closest('[data-fbt-add]'); if(!b) return;
      e.preventDefault();
      var vid = b.getAttribute('data-fbt-add'); if(!vid) return;
      b.style.opacity = '.6'; b.style.pointerEvents = 'none';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: vid, quantity: 1 }] }) })
        .then(function(){ return bcRefreshDrawer(true); })
        .catch(function(){ b.style.opacity=''; b.style.pointerEvents=''; });
    });

    /* Safety net: after ANY re-render of the drawer, re-apply this page's settings AND (re)build the
       automatic upsell when needed — regardless of which script triggered the render. */
    (function bcSettingsObserver() {
      var dr = document.getElementById('cart-drawer'); if (!dr) return;
      var busy = false;
      var run = function () {
        if (busy) return; busy = true;
        try { bcEnforceSettings(dr); } catch (e) {}
        busy = false;
        try { bcMaybeAutoUpsell(); } catch (e) {}
      };
      try { var mo = new MutationObserver(function () { if (!busy) { run(); } }); mo.observe(dr, { childList: true, subtree: true }); } catch (e) {}
      run();
    })();

    function bcRefreshDrawer(scrollToTop) {
      var d0 = document.querySelector('cart-drawer');
      var b0 = d0 && d0.shadowRoot ? d0.shadowRoot.querySelector('[part~="body"]') : null;
      var prevScroll = b0 ? b0.scrollTop : 0;
      return fetch(window.location.pathname + '?sections=cart-drawer', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var html = data && data['cart-drawer'];
          if (!html) { return; }
          var tmp = document.createElement('div');
          tmp.innerHTML = html;
          var fresh = tmp.querySelector('#cart-drawer');
          var cur = document.querySelector('#cart-drawer');
          if (fresh && cur) {
            cur.innerHTML = fresh.innerHTML;
            bcEnforceSettings(cur);
            var drEl = document.querySelector('cart-drawer');
            var bodyPart = drEl && drEl.shadowRoot ? drEl.shadowRoot.querySelector('[part~="body"]') : null;
            /* Only jump to the top when a real product was added (show the new item). For the shipping-
               protection toggle, quantity changes and removals, keep the shopper where they were. */
            if (bodyPart) { bodyPart.scrollTop = scrollToTop ? 0 : prevScroll; }
          }
        })
        .catch(function () {});
    }



    document.addEventListener('click', function (e) {
      // line-item quantity stepper
      var qbtn = e.target.closest('.bc-li__qtybtn');
      if (qbtn) {
        e.preventDefault();
        var wrap = qbtn.closest('.bc-li__qty');
        if (!wrap || wrap.classList.contains('is-loading')) return;
        var key = wrap.getAttribute('data-key');
        var cur = parseInt(wrap.querySelector('.bc-li__qtyval').textContent, 10) || 0;
        var next = cur + parseInt(qbtn.getAttribute('data-delta'), 10);
        if (next < 0) { next = 0; }
        wrap.classList.add('is-loading');
        fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: key, quantity: next }) })
          .then(function () { bcRefreshDrawer(); })
          .catch(function () { wrap.classList.remove('is-loading'); });
        return;
      }
      // line-item remove
      var rbtn = e.target.closest('.bc-li__remove');
      if (rbtn) {
        e.preventDefault();
        rbtn.disabled = true;
        fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: rbtn.getAttribute('data-key'), quantity: 0 }) })
          .then(function () { bcRefreshDrawer(); });
        return;
      }
      // shipping protection toggle
      var btn = e.target.closest('.bc-toggle');
      if (!btn) return;
      e.preventDefault();
      var variant = btn.getAttribute('data-variant');
      if (!variant) return;
      var isOn = btn.classList.contains('is-on');
      btn.classList.add('is-loading');

      var req = isOn
        ? fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: variant, quantity: 0 }) })
        : fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: variant, quantity: 1 }] }) });

      req.then(function () { bcRefreshDrawer(); })
         .catch(function () { btn.classList.remove('is-loading'); });
    });

    /* ---------- Custom in-drawer variant picker ---------- */
    var bcP = { product: null, selected: {} };
    function bcMoney(c){ return '£' + (c/100).toFixed(2); }
    function bcPickerEl(){ return document.getElementById('bc-picker'); }
    function bcOptVals(prod, idx){ var seen={}, out=[]; prod.variants.forEach(function(v){ var val=v.options[idx]; if(!seen[val]){ seen[val]=1; out.push(val); } }); return out; }
    function bcVariantFor(sel){ return bcP.product.variants.find(function(v){ return Object.keys(sel).every(function(i){ return v.options[i]===sel[i]; }); }); }
    function bcAvail(prod, idx, val){ var sel=bcP.selected; return prod.variants.some(function(v){ if(v.options[idx]!==val) return false; if(!v.available) return false; return Object.keys(sel).every(function(i){ return (i==idx)||v.options[i]===sel[i]; }); }); }
    function bcImgW(src,w){ if(!src) return ''; return src + (src.indexOf('?')>-1?'&':'?') + 'width=' + w; }

    /* Best variant matching the current (possibly partial) selection — drives the head image + price,
       so the photo switches the moment a colour is chosen (before a size is picked). */
    function bcRepVariant(){
      var prod=bcP.product, sel=bcP.selected, keys=Object.keys(sel);
      if(!keys.length) return null;
      return prod.variants.find(function(x){ return keys.every(function(i){ return x.options[i]===sel[i]; }); }) || null;
    }
    function bcHeadHtml(){
      var prod=bcP.product, v=bcRepVariant();
      var img = (v && v.featured_image ? v.featured_image.src : (prod.featured_image || (prod.images && prod.images[0])));
      var price = v ? v.price : prod.price;
      var compare = v ? v.compare_at_price : prod.compare_at_price;
      var h = '<div class="bc-picker__head">';
      if(img) h += '<img class="bc-picker__img" src="' + bcImgW(img,160) + '" alt="">';
      h += '<div><p class="bc-picker__title">' + prod.title + '</p><div class="bc-picker__prices">';
      if(compare && compare>price) h += '<span class="bc-picker__was">' + bcMoney(compare) + '</span><span class="bc-picker__now is-sale">' + bcMoney(price) + '</span>';
      else h += '<span class="bc-picker__now">' + bcMoney(price) + '</span>';
      h += '</div></div></div>';
      return h;
    }
    function bcOptionsHtml(){
      var prod=bcP.product, sel=bcP.selected, h='';
      prod.options.forEach(function(name,i){
        var optLabel = (name && name.name) ? name.name : name;
        var isColour = /colou?r/i.test(optLabel);
        h += '<div class="bc-picker__optname"><span>' + optLabel + '</span></div>';
        h += '<div class="bc-picker__vals' + (isColour ? ' is-swatches' : '') + '">';
        bcOptVals(prod,i).forEach(function(val){
          var cls = 'bc-picker__val' + (isColour ? ' bc-picker__swatch' : '');
          if (sel[i] === val) cls += ' is-selected';
          if (!bcAvail(prod,i,val)) cls += ' is-unavailable';
          var esc = String(val).replace(/"/g,'&quot;');
          if (isColour) {
            var vv = prod.variants.find(function(x){ return x.options[i] === val; });
            var im = (vv && vv.featured_image) ? vv.featured_image.src : (prod.featured_image || '');
            h += '<button type="button" class="' + cls + '" data-opt="' + i + '" data-val="' + esc + '" title="' + esc + '"><img src="' + bcImgW(im,140) + '" alt="' + esc + '"><span class="bc-picker__swatch-label">' + val + '</span></button>';
          } else {
            h += '<button type="button" class="' + cls + '" data-opt="' + i + '" data-val="' + esc + '">' + val + '</button>';
          }
        });
        h += '</div>';
      });
      return h;
    }
    function bcAddBtnHtml(){
      var prod=bcP.product, sel=bcP.selected, v=null;
      if(Object.keys(sel).length===prod.options.length) v=bcVariantFor(sel);
      var ready = v && v.available;
      return '<button type="button" class="bc-picker__add" data-bc-add ' + (ready?'':'disabled') + '>' + (ready?'Add to cart':'Select options') + '</button>';
    }
    function bcRenderPicker(){
      var back = bcP.fromCart ? '<button type="button" class="bc-picker__back" data-bc-close>&larr; Back to cart</button>' : '';
      document.getElementById('bc-picker-content').innerHTML = back + bcHeadHtml() + bcOptionsHtml() + bcAddBtnHtml();
    }
    /* Teach the drawer that clicks inside our picker sheet OR inside a Klaviyo pop-up count as "inside"
       itself, so the theme's "click-outside-closes-drawer" logic never fires for them. This is what stops
       the slide-cart from collapsing when you tap the Klaviyo (or picker) close X. Scoped to those two
       things only; every other click behaves natively. Touches no data, GMC or theme structure. */
    (function bcGuardDrawer(){
      var dr = document.getElementById('cart-drawer'); if(!dr) return;
      var INSIDE = '#bc-picker, [class*="kl-private-reset-css"], .klaviyo-form, [data-testid="POPUP"]';
      dr.contains = function(node){
        try { if(node && node.nodeType===1 && node.closest && node.closest(INSIDE)) return true; } catch(e){}
        return Node.prototype.contains.call(this, node);
      };
    })();
    function bcLockDrawer(){}
    function bcUnlockDrawer(){}

    function bcOpenPicker(handle, fromCart){
      fetch('/products/' + handle + '.js').then(function(r){ return r.json(); }).then(function(prod){
        bcP.product = prod; bcP.selected = {}; bcP.fromCart = !!fromCart;
        prod.options.forEach(function(o,i){ var vals=bcOptVals(prod,i); if(vals.length===1) bcP.selected[i]=vals[0]; });
        bcRenderPicker();
        bcLockDrawer();
        var el=bcPickerEl();
        if(el){ if(el.showModal && !el.open){ try { el.showModal(); } catch(e){ el.setAttribute('open',''); } } else { el.setAttribute('open',''); } }
      });
    }
    function bcClosePicker(){ var el=bcPickerEl(); if(el){ if(el.close && el.open){ try { el.close(); } catch(e){ el.removeAttribute('open'); } } else { el.removeAttribute('open'); } } bcUnlockDrawer(); }

    /* FBT upsell "ADD +" -> open the full-screen picker sheet (dims the page; the cart stays open behind it). */
    document.addEventListener('click', function(e){
      var opener = e.target.closest('[data-bc-picker]');
      if(opener){ e.preventDefault(); bcOpenPicker(opener.getAttribute('data-handle'), true); }
    });

    /* The collection/product-page "+" quick-add is intentionally left to the theme's OWN native quick-buy
       pop-up (we no longer intercept it). That native flow never triggers the cart scroll-freeze, so the
       cart stays perfectly stable. Our custom picker is used only for the in-cart upsell (data-bc-picker). */

    /* Interactions inside the picker sheet. No event-phase tricks needed — while the sheet is open the
       drawer treats these clicks as "inside" (see bcLockDrawer), so the cart never slides away, and the
       tapped control receives the event normally (reliable on mobile). */
    (function bindPicker(){
      var pk = document.getElementById('bc-picker');
      if(!pk){ return; }
      pk.addEventListener('close', function(){ bcUnlockDrawer(); });        /* Escape / dialog close */
      pk.addEventListener('cancel', function(e){ e.preventDefault(); bcClosePicker(); });
      pk.addEventListener('click', function(e){
        if(e.target === pk){ bcClosePicker(); return; }                     /* click on the ::backdrop area */
        if(e.target.closest('[data-bc-close]')){ e.preventDefault(); bcClosePicker(); return; }
        var val = e.target.closest('.bc-picker__val');
        if(val){ e.preventDefault(); if(val.classList.contains('is-unavailable')) return; bcP.selected[val.getAttribute('data-opt')] = val.getAttribute('data-val'); bcRenderPicker(); return; }
        var addBtn = e.target.closest('[data-bc-add]');
        if(addBtn && !addBtn.disabled){
          e.preventDefault();
          var variant = bcVariantFor(bcP.selected);
          if(!variant) return;
          addBtn.disabled = true; addBtn.textContent = 'Adding…';
          fetch('/cart/add.js', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ items:[{ id: variant.id, quantity:1 }] }) })
            .then(function(){
              bcClosePicker();
              var op = document.querySelector('[aria-controls="cart-drawer"]');
              var dr = document.querySelector('cart-drawer');
              if(op && dr && !dr.hasAttribute('open')){
                // opened from a collection/product page (cart was closed) -> open the fresh cart
                bcRefreshDrawer(true).then(function(){ op.click(); });
              } else {
                bcRefreshDrawer(true);
              }
            })
            .catch(function(){ addBtn.disabled=false; addBtn.textContent='Add to cart'; });
          return;
        }
      });
    })();
  })();
</script>

