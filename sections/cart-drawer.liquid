  .bc-protection__price { font-size: 12.5px; color: #8f8f8f; }
  .bc-toggle { position: relative; width: 40px; height: 22px; border-radius: 100px; background: #cfcfcf; border: 0; cursor: pointer; padding: 0; flex: 0 0 auto; transition: background-color .2s ease; }
