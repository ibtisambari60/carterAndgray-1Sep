    { "type": "text", "id": "empty_label_1", "label": "Tile 1 label", "default": "Women" },
    { "type": "collection", "id": "empty_collection_2", "label": "Tile 2 collection" },
    { "type": "image_picker", "id": "empty_image_2", "label": "Tile 2 image (Men)", "info": "Leave empty to use the current default image." },
    { "type": "text", "id": "empty_label_2", "label": "Tile 2 label", "default": "Men" },

    { "type": "header", "content": "Shipping protection" },
    { "type": "checkbox", "id": "show_shipping_protection", "label": "Show shipping protection", "default": true },
    { "type": "text", "id": "shipping_protection_variant", "label": "Shipping protection variant ID", "default": "58170155696476" },
    { "type": "text", "id": "protection_title", "label": "Title", "default": "100% Shipping Protection" },
    { "type": "text", "id": "protection_sub", "label": "Subtitle", "default": "Don't take any risks" },
    { "type": "text", "id": "protection_price", "label": "Price label", "default": "£2.95" },

    { "type": "header", "content": "Footer" },
    { "type": "text", "id": "free_delivery_text", "label": "Delivery text", "default": "FREE DELIVERY" },
    { "type": "checkbox", "id": "show_checkout_button", "label": "Show checkout button", "default": true },
    { "type": "text", "id": "checkout_text", "label": "Checkout button text", "default": "Checkout Securely" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },

    { "type": "header", "content": "Reviews / trust line" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews line", "default": true },
    { "type": "range", "id": "reviews_rating", "label": "Star rating", "min": 0, "max": 5, "step": 0.5, "default": 4.5 },
    { "type": "text", "id": "reviews_text", "label": "Reviews / trust line", "default": "4.7/5 (2749+ reviews)" }
  ]
}
