{% comment %}
  CG Tabbed Premium Slider
  Geschikt voor Shopify Prestige

  Eén section met drie tabs:
  1. Trending Now — collecties
  2. Our Picks for You — producten
  3. New Arrivals — producten

  Elk block wordt handmatig aan één tab gekoppeld.
{% endcomment %}

{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.tab_font | font_face: font_display: 'swap' }}
  {{ section.settings.card_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    --cg-tabs-bg: {{ section.settings.background_color }};
    --cg-tabs-text: {{ section.settings.text_color }};
    --cg-tabs-muted: {{ section.settings.muted_text_color }};
    --cg-tabs-active: {{ section.settings.active_tab_color }};
    --cg-tabs-inactive: {{ section.settings.inactive_tab_color }};
    --cg-tabs-image-bg: {{ section.settings.image_background }};
    --cg-tabs-arrow-bg: {{ section.settings.arrow_background }};
    --cg-tabs-arrow-color: {{ section.settings.arrow_color }};

    --cg-mobile-side: {{ section.settings.mobile_side_padding }}px;
    --cg-desktop-side: {{ section.settings.desktop_side_padding }}px;

    --cg-mobile-card-width: {{ section.settings.mobile_card_width }}%;
    --cg-mobile-gap: {{ section.settings.mobile_card_gap }}px;
    --cg-desktop-gap: {{ section.settings.desktop_card_gap }}px;
    --cg-desktop-columns: {{ section.settings.desktop_cards_per_view }};
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider,
  #shopify-section-{{ section.id }} .cg-tabbed-slider * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--cg-tabs-bg);
    color: var(--cg-tabs-text);
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__inner {
    width: 100%;
    padding:
      {{ section.settings.mobile_padding_top }}px
      0
      {{ section.settings.mobile_padding_bottom }}px;
  }

  /* =========================
     HEADING
  ========================= */

  #shopify-section-{{ section.id }} .cg-tabbed-slider__heading-row {
    display: flex;
    width: 100%;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding:
      0
      var(--cg-mobile-side)
      {{ section.settings.mobile_heading_tabs_gap }}px;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__heading {
    margin: 0;
    padding: 0;
    color: var(--cg-tabs-text);

    font-family:
      {{ section.settings.heading_font.family }},
      {{ section.settings.heading_font.fallback_families }};

    font-size: {{ section.settings.mobile_heading_size }}px;
    font-style: {{ section.settings.heading_font.style }};
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height }}%;
    letter-spacing: calc(
      {{ section.settings.heading_letter_spacing }} / 100 * 1em
    );
  }

  /* =========================
     TABS + ARROWS
  ========================= */

  #shopify-section-{{ section.id }} .cg-tabbed-slider__controls {
    display: flex;
    width: 100%;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding:
      0
      var(--cg-mobile-side)
      {{ section.settings.mobile_tabs_slider_gap }}px;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__tabs {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: {{ section.settings.mobile_tab_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__tabs::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__tab {
    position: relative;
    flex: 0 0 auto;
    margin: 0;
    padding:
      0
      0
      {{ section.settings.tab_underline_offset }}px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--cg-tabs-inactive);
    cursor: pointer;

    font-family:
      {{ section.settings.tab_font.family }},
      {{ section.settings.tab_font.fallback_families }};

    font-size: {{ section.settings.mobile_tab_size }}px;
    font-style: {{ section.settings.tab_font.style }};
    font-weight: {{ section.settings.inactive_tab_weight }};
    line-height: {{ section.settings.tab_line_height }}%;
    letter-spacing: calc(
      {{ section.settings.tab_letter_spacing }} / 100 * 1em
    );

    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    appearance: none;
    -webkit-appearance: none;

    {% if section.settings.uppercase_tabs %}
      text-transform: uppercase;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__tab::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: {{ section.settings.tab_underline_thickness }}px;
    background: currentColor;
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__tab[aria-selected="true"] {
    color: var(--cg-tabs-active);
    font-weight: {{ section.settings.active_tab_weight }};
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__tab[aria-selected="true"]::after {
    opacity: 1;
    transform: scaleX(1);
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__arrows {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    gap: {{ section.settings.arrow_gap }}px;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__arrow {
    display: inline-flex;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: {{ section.settings.arrow_border_width }}px solid {{ section.settings.arrow_border_color }};
    border-radius: {{ section.settings.arrow_radius }}px;
    background: var(--cg-tabs-arrow-bg);
    color: var(--cg-tabs-arrow-color);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;

    transition:
      opacity 160ms ease,
      background-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__arrow:hover {
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__arrow:disabled {
    cursor: default;
    opacity: 0.3;
    transform: none;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__arrow svg {
    display: block;
    width: 42%;
    height: 42%;
  }

  /* =========================
     PANELS
  ========================= */

  #shopify-section-{{ section.id }} .cg-tabbed-slider__panel {
    display: none;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__panel.is-active {
    display: block;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__track {
    display: flex;
    width: 100%;
    gap: var(--cg-mobile-gap);
    margin: 0;
    padding:
      0
      var(--cg-mobile-side)
      {{ section.settings.mobile_track_bottom_padding }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--cg-mobile-side);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__card {
    flex: 0 0 var(--cg-mobile-card-width);
    min-width: 0;
    scroll-snap-align: start;
  }

  /* =========================
     CARD MEDIA
  ========================= */

  #shopify-section-{{ section.id }} .cg-tabbed-slider__media {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--cg-tabs-image-bg);
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__card[data-item-type="collection"]
    .cg-tabbed-slider__media {
    {% case section.settings.collection_image_ratio %}
      {% when 'square' %}
        aspect-ratio: 1 / 1;
      {% when 'portrait' %}
        aspect-ratio: 4 / 5;
      {% when 'tall' %}
        aspect-ratio: 3 / 4;
      {% when 'landscape' %}
        aspect-ratio: 4 / 3;
      {% else %}
        aspect-ratio: 4 / 5;
    {% endcase %}
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__card[data-item-type="product"]
    .cg-tabbed-slider__media {
    {% case section.settings.product_image_ratio %}
      {% when 'square' %}
        aspect-ratio: 1 / 1;
      {% when 'portrait' %}
        aspect-ratio: 4 / 5;
      {% when 'tall' %}
        aspect-ratio: 3 / 4;
      {% when 'landscape' %}
        aspect-ratio: 4 / 3;
      {% else %}
        aspect-ratio: 4 / 5;
    {% endcase %}
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__image,
#shopify-section-{{ section.id }} .cg-tabbed-slider__placeholder,
#shopify-section-{{ section.id }} .cg-tabbed-slider__placeholder svg {
  display: block;
  width: 100%;
}

#shopify-section-{{ section.id }} .cg-tabbed-slider__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: var(--cg-card-image-position, center center);
  transform: scale(1.001);
  transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
}
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__placeholder svg {
    object-fit: cover;
  }

  {% if section.settings.enable_image_zoom %}
    #shopify-section-{{ section.id }} .cg-tabbed-slider__media:hover
      .cg-tabbed-slider__image {
      transform: scale(1.025);
    }
  {% endif %}

  /* =========================
     CARD CONTENT
  ========================= */

  #shopify-section-{{ section.id }} .cg-tabbed-slider__card-content {
    padding-top: {{ section.settings.mobile_image_content_gap }}px;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__card-title {
    display: block;
    margin: 0;
    padding: 0;
    color: var(--cg-tabs-text);

    font-family:
      {{ section.settings.card_font.family }},
      {{ section.settings.card_font.fallback_families }};

    font-size: {{ section.settings.mobile_card_title_size }}px;
    font-style: {{ section.settings.card_font.style }};
    font-weight: {{ section.settings.card_title_weight }};
    line-height: {{ section.settings.card_title_line_height }}%;
    letter-spacing: calc(
      {{ section.settings.card_title_letter_spacing }} / 100 * 1em
    );

    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__card-title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__collection-link {
    position: relative;
    display: inline-block;
    width: fit-content;
    margin-top: {{ section.settings.collection_title_link_gap }}px;
    padding-bottom: {{ section.settings.collection_link_underline_offset }}px;
    color: var(--cg-tabs-text);

    font-family:
      {{ section.settings.card_font.family }},
      {{ section.settings.card_font.fallback_families }};

    font-size: {{ section.settings.mobile_collection_link_size }}px;
    font-style: {{ section.settings.card_font.style }};
    font-weight: {{ section.settings.collection_link_weight }};
    line-height: 1.1;
    letter-spacing: calc(
      {{ section.settings.collection_link_letter_spacing }} / 100 * 1em
    );

    text-decoration: none;

    {% if section.settings.uppercase_collection_link %}
      text-transform: uppercase;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__collection-link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: {{ section.settings.collection_link_underline_thickness }}px;
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: {{ section.settings.price_gap }}px;
    margin-top: {{ section.settings.product_title_price_gap }}px;
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__price,
  #shopify-section-{{ section.id }} .cg-tabbed-slider__compare-price {
    color: var(--cg-tabs-text);

    font-family:
      {{ section.settings.card_font.family }},
      {{ section.settings.card_font.fallback_families }};

    font-size: {{ section.settings.mobile_price_size }}px;
    font-style: {{ section.settings.card_font.style }};
    font-weight: {{ section.settings.price_weight }};
    line-height: 1.2;
    letter-spacing: calc(
      {{ section.settings.price_letter_spacing }} / 100 * 1em
    );
  }

  #shopify-section-{{ section.id }} .cg-tabbed-slider__compare-price {
    color: var(--cg-tabs-muted);
    text-decoration: line-through;
  }

  /* Empty state */

  #shopify-section-{{ section.id }} .cg-tabbed-slider__empty {
    width: 100%;
    padding:
      30px
      var(--cg-mobile-side);
    color: var(--cg-tabs-muted);
    font-family:
      {{ section.settings.card_font.family }},
      {{ section.settings.card_font.fallback_families }};
    font-size: 14px;
  }

  /* =========================
     DESKTOP
  ========================= */

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cg-tabbed-slider__inner {
      padding:
        {{ section.settings.desktop_padding_top }}px
        0
        {{ section.settings.desktop_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__heading-row {
      padding:
        0
        var(--cg-desktop-side)
        {{ section.settings.desktop_heading_tabs_gap }}px;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__heading {
      font-size: {{ section.settings.desktop_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__controls {
      padding:
        0
        var(--cg-desktop-side)
        {{ section.settings.desktop_tabs_slider_gap }}px;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__tabs {
      gap: {{ section.settings.desktop_tab_gap }}px;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__tab {
      font-size: {{ section.settings.desktop_tab_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__arrows {
      display: flex;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__track {
      gap: var(--cg-desktop-gap);
      padding:
        0
        var(--cg-desktop-side)
        {{ section.settings.desktop_track_bottom_padding }}px;
      scroll-padding-left: var(--cg-desktop-side);
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__card {
      flex-basis: calc(
        (
          100%
          - (
            (var(--cg-desktop-columns) - 1)
            * var(--cg-desktop-gap)
          )
          - (2 * var(--cg-desktop-side))
        )
        / var(--cg-desktop-columns)
      );
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__card-content {
      padding-top: {{ section.settings.desktop_image_content_gap }}px;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__card-title {
      font-size: {{ section.settings.desktop_card_title_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__collection-link {
      font-size: {{ section.settings.desktop_collection_link_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__price,
    #shopify-section-{{ section.id }} .cg-tabbed-slider__compare-price {
      font-size: {{ section.settings.desktop_price_size }}px;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__empty {
      padding-right: var(--cg-desktop-side);
      padding-left: var(--cg-desktop-side);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .cg-tabbed-slider__track {
      scroll-behavior: auto;
    }

    #shopify-section-{{ section.id }} .cg-tabbed-slider__image,
    #shopify-section-{{ section.id }} .cg-tabbed-slider__arrow {
      transition: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign starting_tab = section.settings.starting_tab

  assign tab_1_label = section.settings.tab_1_label
  assign tab_2_label = section.settings.tab_2_label
  assign tab_3_label = section.settings.tab_3_label
-%}

<section
  id="CGTabbedSlider-{{ section.id }}"
  class="cg-tabbed-slider"
  data-section-id="{{ section.id }}"
>
  <div class="cg-tabbed-slider__inner">

    {%- if section.settings.heading != blank -%}
      <div class="cg-tabbed-slider__heading-row">
        <h2 class="cg-tabbed-slider__heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    <div class="cg-tabbed-slider__controls">
      <div
        class="cg-tabbed-slider__tabs"
        role="tablist"
        aria-label="{{ section.settings.tabs_accessibility_label | escape }}"
      >
        {%- if tab_1_label != blank -%}
          <button
            type="button"
            class="cg-tabbed-slider__tab"
            id="CGTab-{{ section.id }}-1"
            role="tab"
            aria-controls="CGPanel-{{ section.id }}-1"
            aria-selected="{% if starting_tab == 'tab_1' %}true{% else %}false{% endif %}"
            tabindex="{% if starting_tab == 'tab_1' %}0{% else %}-1{% endif %}"
            data-cg-tab="tab_1"
          >
            {{ tab_1_label }}
          </button>
        {%- endif -%}

        {%- if tab_2_label != blank -%}
          <button
            type="button"
            class="cg-tabbed-slider__tab"
            id="CGTab-{{ section.id }}-2"
            role="tab"
            aria-controls="CGPanel-{{ section.id }}-2"
            aria-selected="{% if starting_tab == 'tab_2' %}true{% else %}false{% endif %}"
            tabindex="{% if starting_tab == 'tab_2' %}0{% else %}-1{% endif %}"
            data-cg-tab="tab_2"
          >
            {{ tab_2_label }}
          </button>
        {%- endif -%}

        {%- if tab_3_label != blank -%}
          <button
            type="button"
            class="cg-tabbed-slider__tab"
            id="CGTab-{{ section.id }}-3"
            role="tab"
            aria-controls="CGPanel-{{ section.id }}-3"
            aria-selected="{% if starting_tab == 'tab_3' %}true{% else %}false{% endif %}"
            tabindex="{% if starting_tab == 'tab_3' %}0{% else %}-1{% endif %}"
            data-cg-tab="tab_3"
          >
            {{ tab_3_label }}
          </button>
        {%- endif -%}
      </div>

      <div
        class="cg-tabbed-slider__arrows"
        aria-label="Slidernavigatie"
      >
        <button
          type="button"
          class="cg-tabbed-slider__arrow"
          aria-label="Vorige items"
          data-cg-direction="previous"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M15 5L8 12L15 19"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <button
          type="button"
          class="cg-tabbed-slider__arrow"
          aria-label="Volgende items"
          data-cg-direction="next"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M9 5L16 12L9 19"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>

    {%- for tab_number in (1..3) -%}
      {%- capture tab_key -%}tab_{{ tab_number }}{%- endcapture -%}
      {%- assign tab_item_count = 0 -%}

      <div
        id="CGPanel-{{ section.id }}-{{ tab_number }}"
        class="cg-tabbed-slider__panel{% if starting_tab == tab_key %} is-active{% endif %}"
        role="tabpanel"
        aria-labelledby="CGTab-{{ section.id }}-{{ tab_number }}"
        {% unless starting_tab == tab_key %}
          hidden
        {% endunless %}
        data-cg-panel="{{ tab_key }}"
      >
        <div class="cg-tabbed-slider__track" data-cg-track>
          {%- for block in section.blocks -%}
            {%- if block.settings.tab_assignment == tab_key -%}
              {%- liquid
                assign card_title = blank
                assign card_url = blank
                assign card_image = block.settings.custom_image
                assign card_image_alt = blank
                assign card_price = blank
                assign card_compare_price = blank
                assign item_available = false

                if block.settings.item_type == 'collection'
                  assign selected_collection = block.settings.collection

                  if selected_collection != blank
                    assign item_available = true
                    assign card_title = block.settings.custom_title | default: selected_collection.title
                    assign card_url = block.settings.custom_link | default: selected_collection.url

                    if card_image == blank
                      assign card_image = selected_collection.featured_image
                    endif
                  endif
                else
                  assign selected_product = block.settings.product

                  if selected_product != blank
                    assign item_available = true
                    assign card_title = block.settings.custom_title | default: selected_product.title
                    assign card_url = block.settings.custom_link | default: selected_product.url

                    if card_image == blank
                      assign card_image = selected_product.featured_image
                    endif

                    assign card_price = selected_product.price
                    assign card_compare_price = selected_product.compare_at_price
                  endif
                endif

                if card_image != blank
                  assign card_image_alt = card_image.alt | default: card_title
                endif
              -%}

              {%- if item_available -%}
                {%- assign tab_item_count = tab_item_count | plus: 1 -%}

                <article
                  class="cg-tabbed-slider__card"
                  data-item-type="{{ block.settings.item_type }}"
                  data-block-id="{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  <a
                    href="{{ card_url }}"
                    class="cg-tabbed-slider__media"
                    aria-label="{{ card_title | escape }}"
                    style="--cg-card-image-position: {{ block.settings.image_position }};"
                  >
                    {%- if card_image != blank -%}
                      {{
                        card_image
                        | image_url: width: 1800
                        | image_tag:
                          class: 'cg-tabbed-slider__image',
                          loading: 'lazy',
                          widths: '240, 320, 400, 480, 600, 720, 900, 1100, 1400, 1800',
                          sizes: '(max-width: 749px) 78vw, 25vw',
                          alt: card_image_alt
                      }}
                    {%- else -%}
                      <div class="cg-tabbed-slider__placeholder">
                        {%- if block.settings.item_type == 'collection' -%}
                          {{ 'collection-1' | placeholder_svg_tag }}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag }}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </a>

                  <div class="cg-tabbed-slider__card-content">
                    <a
                      href="{{ card_url }}"
                      class="cg-tabbed-slider__card-title"
                    >
                      {{ card_title }}
                    </a>

                    {%- if block.settings.item_type == 'collection' -%}
                      {%- if section.settings.collection_link_label != blank -%}
                        <a
                          href="{{ card_url }}"
                          class="cg-tabbed-slider__collection-link"
                        >
                          {{ section.settings.collection_link_label }}
                        </a>
                      {%- endif -%}
                    {%- else -%}
                      <div class="cg-tabbed-slider__price-row">
                        {%- if section.settings.show_compare_at_price
                          and card_compare_price > card_price
                        -%}
                          <span class="cg-tabbed-slider__compare-price">
                            {{ card_compare_price | money }}
                          </span>
                        {%- endif -%}

                        <span class="cg-tabbed-slider__price">
                          {{ card_price | money }}
                        </span>
                      </div>
                    {%- endif -%}
                  </div>
                </article>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if tab_item_count == 0 -%}
          <div class="cg-tabbed-slider__empty">
            Voeg blocks toe en koppel ze aan deze tab.
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  (() => {
    const sectionId = {{ section.id | json }};

    function initialiseCGTabbedSlider(root) {
      if (!root || root.dataset.cgInitialised === 'true') return;

      root.dataset.cgInitialised = 'true';

      const tabs = Array.from(
        root.querySelectorAll('[data-cg-tab]')
      );

      const panels = Array.from(
        root.querySelectorAll('[data-cg-panel]')
      );

      const previousButton = root.querySelector(
        '[data-cg-direction="previous"]'
      );

      const nextButton = root.querySelector(
        '[data-cg-direction="next"]'
      );

      function getActivePanel() {
        return panels.find((panel) =>
          panel.classList.contains('is-active')
        );
      }

      function getActiveTrack() {
        return getActivePanel()?.querySelector('[data-cg-track]');
      }

      function updateArrowState() {
        const track = getActiveTrack();

        if (!track || !previousButton || !nextButton) return;

        const maximumScroll =
          track.scrollWidth - track.clientWidth;

        previousButton.disabled = track.scrollLeft <= 2;
        nextButton.disabled =
          track.scrollLeft >= maximumScroll - 2;
      }

      function activateTab(tabKey, focusTab = false) {
        tabs.forEach((tab) => {
          const isActive = tab.dataset.cgTab === tabKey;

          tab.setAttribute(
            'aria-selected',
            isActive ? 'true' : 'false'
          );

          tab.tabIndex = isActive ? 0 : -1;

          if (isActive && focusTab) {
            tab.focus({ preventScroll: true });
          }
        });

        panels.forEach((panel) => {
          const isActive = panel.dataset.cgPanel === tabKey;

          panel.classList.toggle('is-active', isActive);
          panel.hidden = !isActive;
        });

        requestAnimationFrame(() => {
          const track = getActiveTrack();

          if (track) {
            track.scrollLeft = 0;
          }

          updateArrowState();
        });
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          activateTab(tab.dataset.cgTab);
        });

        tab.addEventListener('keydown', (event) => {
          if (
            event.key !== 'ArrowLeft' &&
            event.key !== 'ArrowRight'
          ) {
            return;
          }

          event.preventDefault();

          const direction =
            event.key === 'ArrowRight' ? 1 : -1;

          const newIndex =
            (index + direction + tabs.length) % tabs.length;

          activateTab(
            tabs[newIndex].dataset.cgTab,
            true
          );
        });
      });

      panels.forEach((panel) => {
        const track = panel.querySelector('[data-cg-track]');

        if (!track) return;

        track.addEventListener(
          'scroll',
          updateArrowState,
          { passive: true }
        );
      });

      function scrollActiveTrack(direction) {
        const track = getActiveTrack();

        if (!track) return;

        const firstCard = track.querySelector(
          '.cg-tabbed-slider__card'
        );

        const computedStyle = window.getComputedStyle(track);
        const gap = parseFloat(computedStyle.columnGap) || 0;

        const distance = firstCard
          ? firstCard.getBoundingClientRect().width + gap
          : track.clientWidth * 0.8;

        track.scrollBy({
          left: direction * distance,
          behavior: 'smooth'
        });
      }

      previousButton?.addEventListener('click', () => {
        scrollActiveTrack(-1);
      });

      nextButton?.addEventListener('click', () => {
        scrollActiveTrack(1);
      });

      window.addEventListener(
        'resize',
        updateArrowState,
        { passive: true }
      );

      updateArrowState();
    }

    const root = document.getElementById(
      `CGTabbedSlider-${sectionId}`
    );

    initialiseCGTabbedSlider(root);

    document.addEventListener(
      'shopify:section:load',
      (event) => {
        if (event.detail.sectionId !== String(sectionId)) return;

        initialiseCGTabbedSlider(
          document.getElementById(
            `CGTabbedSlider-${sectionId}`
          )
        );
      }
    );

    document.addEventListener(
      'shopify:block:select',
      (event) => {
        const currentRoot = document.getElementById(
          `CGTabbedSlider-${sectionId}`
        );

        if (!currentRoot) return;

        const selectedBlock = currentRoot.querySelector(
          `[data-block-id="${event.detail.blockId}"]`
        );

        const panel = selectedBlock?.closest(
          '[data-cg-panel]'
        );

        if (!panel) return;

        const targetTab = currentRoot.querySelector(
          `[data-cg-tab="${panel.dataset.cgPanel}"]`
        );

        targetTab?.click();

        selectedBlock.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
          inline: 'center'
        });
      }
    );
  })();
</script>

