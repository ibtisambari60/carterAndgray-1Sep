    "cg_editorial_faq_hCQGdX": {
      "type": "cg-editorial-faq",
      "blocks": {
        "question_3tLF7L": {
          "type": "question",
          "settings": {
            "question": "What are the shipping costs?",
            "answer": "<p>We offer <strong>free shipping</strong> on all orders within the United States. </p>",
            "open_by_default": false
          }
        },
        "question_zzhqQL": {
          "type": "question",
          "settings": {
            "question": "Can I track my order?",
            "answer": "<p>Yes. Once your order has been shipped, you will receive a confirmation email containing your tracking details, allowing you to monitor the progress of your delivery.</p>",
            "open_by_default": false
          }
        },
        "question_rQHamK": {
          "type": "question",
          "settings": {
            "question": "How do I return an item?",
            "answer": "<p>If you'd like to return an item, you may do so within 30 days of receipt, as long as it's unworn, unwashed and in its original condition.</p><p>To start the process, please contact us at <a href=\"mailto:info@carterandgray.com\" title=\"mailto:info@carterandgray.com\"><strong>info@carterandgray.com</strong></a> . Our team will guide you through the next steps.</p><p>Further details can be found in our <a href=\"/policies/refund-policy\" title=\"Refund Policy\">Refund Policy</a><em><strong>.</strong></em></p>",
            "open_by_default": false
          }
        },
        "question_UkiHfk": {
          "type": "question",
          "settings": {
            "question": "How can I contact Customer Care?",
            "answer": "<p>If you need any assistance, our Customer Care team is happy to help.</p><p>Email: <a href=\"mailto:info@carterandgray.com\"><strong>info@carterandgray.com</strong></a><br/>Phone: +1 (646) 980-4459</p><p>Customer Care Hours:<br/>Monday to Friday | 9:00 AM – 6:00 PM (ET)<br/>Weekends | Closed</p><p>You can also use our <a href=\"/pages/contact\" title=\"Contact\">contact form</a> and we will respond as promptly as possible.</p>",
            "open_by_default": false
          }
        },
        "question_qFtf3X": {
          "type": "question",
          "settings": {
            "question": "How do I choose the correct size?",
            "answer": "<p>A detailed size guide is available on almost every product page to help you find the best fit.</p><p>If you'd like more advice, our Customer Care team is happy to help at <a href=\"mailto:info@carterandgray.com\" title=\"mailto:info@carterandgray.com\"><strong>info@carterandgray.com </strong></a>.</p>",
            "open_by_default": false
          }
        }
      },
