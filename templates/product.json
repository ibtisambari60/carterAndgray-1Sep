        "liquid_yALtCz": {
          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "<style>\n:root{\n  --usp-shift-x: 10px;   /* verplaatst alles naar links, pas 0 → -10px voor fine-tune */\n  --icon-size: 24px;\n  --gap: 8px;\n  --dot-size: 12px;\n  --dot-nudge-y: 1px;\n}\n\n/* Hele container naar links verschoven */\n.usp-wrap{\n  transform: translateX(var(--usp-shift-x));\n}\n\n.usp-line{\n  display: flex;\n  align-items: center;\n  gap: var(--gap);\n  font-size: 16px;\n  color: #1C1C1C;\n  margin: 0 0 10px 0;\n}\n\n/* Uniforme icon-slot */\n.usp-line .icon{\n  width: var(--icon-size);\n  height: var(--icon-size);\n  flex: 0 0 var(--icon-size);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* Afbeeldingsiconen */\n.usp-line img{\n  width: var(--icon-size);\n  height: var(--icon-size);\n  object-fit: contain;\n  display: block;\n}\n\n/* Groene dot — 100% stabiel rond en gecentreerd */\n.usp-line .dot{\n  width: var(--dot-size);\n  height: var(--dot-size);\n  min-width: var(--dot-size);\n  min-height: var(--dot-size);\n  border-radius: 50%;\n  background: #307A07;\n  box-shadow: 0 0 0 6px rgba(48,122,7,0.15);\n  animation: pulse 1.8s infinite ease-in-out;\n  transform: translateY(var(--dot-nudge-y));\n}\n\n@keyframes pulse{\n  0%   { box-shadow:0 0 0 6px rgba(48,122,7,0.15); transform:translateY(var(--dot-nudge-y)) scale(1); }\n  50%  { box-shadow:0 0 0 10px rgba(48,122,7,0.05); transform:translateY(var(--dot-nudge-y)) scale(1.05); }\n  100% { box-shadow:0 0 0 6px rgba(48,122,7,0.15); transform:translateY(var(--dot-nudge-y)) scale(1); }\n}\n\n.usp-line b{ font-weight:700; }\n</style>\n\n<div class=\"usp-wrap\">\n  <div class=\"usp-line\">\n    <span class=\"icon\"><span class=\"dot\"></span></span>\n    <span>Op voorraad en klaar om te verzenden</span>\n  </div>\n\n  <div class=\"usp-line\">\n    <span class=\"icon\">\n      <img src=\"{{ 'delivery-status_1.png' | file_url }}\" alt=\"Retourneren icoon\">\n    </span>\n    <span><b>30 dagen</b> zorgeloos retourneren</span>\n  </div>\n\n  <div class=\"usp-line\">\n    <span class=\"icon\">\n      <img src=\"{{ 'delivery-truck_2.png' | file_url }}\" alt=\"Gratis verzending icoon\">\n    </span>\n    <span><b>Gratis</b> verzending</span>\n  </div>\n</div>",
