            "liquid": "<style>\n.cg-trust-list{\n    display:flex;\n    flex-direction:column;\n    gap:2px;\n    margin:2px 0 2px;\n    padding:0;\n}\n\n.cg-trust-row{\n    display:grid;\n    grid-template-columns:20px 1fr;\n    column-gap:12px;\n    align-items:center;\n\n    margin:0;\n    padding:0;\n\n    min-height:20px;\n\n    font-size:14px;\n    line-height:1.15;\n    color:#1C1C1C;\n}\n\n.cg-trust-row__icon,\n.cg-trust-row__dot-holder{\n    width:20px;\n    height:20px;\n\n    display:flex;\n    align-items:center;\n    justify-content:center;\n}\n\n.cg-trust-row__icon img{\n    width:18px;\n    height:18px;\n    display:block;\n    object-fit:contain;\n}\n\n.cg-trust-row__icon--truck img{\n    transform:scale(1.15);\n}\n\n.cg-trust-row__dot-holder{\n    position:relative;\n    left:0;\n    transform:translateX(-1px);\n}\n.cg-trust-row__dot{\n    width:9px;\n    height:9px;\n\n    border-radius:50%;\n    background:{{ settings.blinktext_IconColor }};\n\n    position:relative;\n}\n\n.cg-trust-row__dot::before{\n    content:\"\";\n    position:absolute;\n\n    width:22px;\n    height:22px;\n\n    top:-6.5px;\n    left:-6.5px;\n\n    border-radius:50%;\n    background:{{ settings.blinktext_IconColor }};\n\n    animation:cgPulse 2s infinite;\n}\n\n@keyframes cgPulse{\n\n0%{\ntransform:scale(.35);\nbox-shadow:0 0 {{ settings.blinktext_IconColor }};\nopacity:.4;\n}\n\n70%{\ntransform:scale(.35);\nbox-shadow:0 0 0 10px {{ settings.blinktext_IconColor }};\nopacity:.4;\n}\n\n100%{\ntransform:scale(.35);\nbox-shadow:0 0 {{ settings.blinktext_IconColor }};\nopacity:.4;\n}\n\n}\n\n.cg-trust-row--available{\n    color:{{ settings.blinktext_TextColor }};\n}\n\n.cg-trust-row strong,\n.cg-trust-row--available span:last-child{\n    font-weight:600;\n}\n</style>\n\n<div class=\"cg-trust-list\">\n\n<div class=\"cg-trust-row cg-trust-row--available\">\n\n<div class=\"cg-trust-row__dot-holder\">\n<div class=\"cg-trust-row__dot\"></div>\n</div>\n\n<span>{{ settings.blinktext_Text | default: \"Available\" }}</span>\n\n</div>\n\n<div class=\"cg-trust-row\">\n\n<div class=\"cg-trust-row__icon\">\n<img src=\"{{ 'Carter_Gray_-_30Days.png' | file_url }}\" alt=\"\">\n</div>\n\n<span><strong>30-Day</strong> Hassle-Free Returns</span>\n\n</div>\n\n<div class=\"cg-trust-row\">\n\n<div class=\"cg-trust-row__icon cg-trust-row__icon--truck\">\n<img src=\"{{ 'Carter_Gray_-_Delivery.png' | file_url }}\" alt=\"\">\n</div>\n\n<span><strong>Free U.S. Shipping</strong> on all orders</span>\n\n</div>\n\n</div>",
